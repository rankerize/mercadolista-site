---
import { CATEGORIES } from '../lib/catalog';
import CameraSearchModal from './CameraSearchModal.astro';
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---

<nav class="ml-nav" aria-label="Navegación principal">
  <div class="ml-nav__inner">

    <!-- Logo -->
    <a href="/" class="ml-nav__brand">
      <img src="/logo.png" alt="Mercado Lista" width="26" height="26" />
      <span>Mercado<strong>Lista</strong></span>
    </a>

    <!-- ≡ Menú -->
    <button
      class="ml-nav__menu-btn"
      id="ml-menu-btn"
      aria-expanded="false"
      aria-controls="ml-drawer"
      aria-label="Abrir menú de categorías"
    >
      <svg width="16" height="12" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <rect width="18" height="2" rx="1" fill="currentColor"/>
        <rect y="6" width="18" height="2" rx="1" fill="currentColor"/>
        <rect y="12" width="18" height="2" rx="1" fill="currentColor"/>
      </svg>
      <span class="ml-menu-label">Menú</span>
    </button>

    <!-- Buscador -->
    <form class="ml-nav__search" id="ml-nav-search" role="search" action="/" method="get">
      <input
        type="search"
        name="q"
        id="ml-nav-q"
        class="ml-search-input"
        placeholder="Buscar productos..."
        autocomplete="off"
        aria-label="Buscar productos"
      />
      <button type="button" id="ml-nav-camera-btn" class="ml-nav-camera-btn" title="Buscar por foto o código de barras" aria-label="Buscar por foto o código de barras">
        📷
      </button>
      <button type="submit" class="ml-search-btn" aria-label="Buscar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </form>

    <!-- Acciones de la derecha -->
    <div class="ml-nav__actions">

      <!-- Asistente IA (solo texto en desktop) -->
      <a
        href="/asistente"
        class="ml-nav__action-btn ml-nav__ia"
        title="Asistente de compras con IA"
      >
        <span aria-hidden="true">🧑‍🍳</span>
        <span class="ml-action-label">Asistente</span>
      </a>

      <!-- Lista / Carrito -->
      <button
        type="button"
        id="header-cart-btn"
        class="ml-nav__action-btn"
        title="Mi lista de compras"
      >
        <span aria-hidden="true">🛒</span>
        <span class="ml-action-label">Lista</span>
        <span id="header-cart-count" class="ml-cart-count">0</span>
      </button>

      <!-- Auth -->
      <div id="header-auth" class="ml-nav__auth">
        <!-- No autenticado -->
        <button type="button" id="header-login-btn" class="ml-nav__login-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span class="ml-action-label">Ingresar</span>
        </button>

        <!-- Autenticado -->
        <div id="header-user-info" class="ml-nav__user" hidden>
          <a href="/perfil" id="header-user-name" class="ml-nav__username" title="Ver mi perfil"></a>
          <a href="/perfil" class="ml-nav__perfil-link">Perfil</a>
          <button type="button" id="header-logout-btn" class="ml-nav__logout">Salir</button>
        </div>
      </div>

    </div>
  </div>
</nav>

<!-- Overlay -->
<div class="ml-overlay" id="ml-overlay" aria-hidden="true"></div>

<!-- Drawer lateral -->
<aside class="ml-drawer" id="ml-drawer" aria-label="Menú de categorías" aria-hidden="true">
  <div class="ml-drawer__head">
    <span class="ml-drawer__greeting">Categorías</span>
    <button class="ml-drawer__close" id="ml-drawer-close" aria-label="Cerrar menú">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <ul class="ml-drawer__list" role="list">
    {CATEGORIES.map((c) => (
      <li>
        <a
          href={`/categoria/${c.id}`}
          class:list={['ml-drawer__link', { 'ml-drawer__link--on': pathname.startsWith(`/categoria/${c.id}`) }]}
        >
          <span class="ml-drawer__ico" aria-hidden="true">{c.icono}</span>
          <span class="ml-drawer__name">{c.nombre}</span>
          <svg class="ml-drawer__arrow" width="7" height="12" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 1 7 7 1 13"/>
          </svg>
        </a>
      </li>
    ))}
  </ul>

  <div class="ml-drawer__footer">
    <a href="/categoria" class="ml-drawer__all">Ver todas las categorías →</a>
  </div>
</aside>

<CameraSearchModal />

<script>
  import { initCameraSearch } from '../scripts/cameraSearch';

  const camModal = initCameraSearch({
    onSearchSelected: (query) => {
      if (window.location.pathname === '/') {
        const mainInput = document.getElementById('query') as HTMLInputElement | null;
        const mainForm  = document.getElementById('search-form') as HTMLFormElement | null;
        if (mainInput && mainForm) {
          mainInput.value = query;
          mainForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
          return;
        }
      }
      window.location.href = `/?q=${encodeURIComponent(query)}`;
    },
  });

  const navCameraBtn = document.getElementById('ml-nav-camera-btn');
  navCameraBtn?.addEventListener('click', () => camModal.open('photo'));

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest('#search-camera-btn, #list-camera-btn');
    if (btn) {
      e.preventDefault();
      camModal.open('photo');
    }
  });

  // Drawer
  const menuBtn  = document.getElementById('ml-menu-btn')!;
  const drawer   = document.getElementById('ml-drawer')!;
  const overlay  = document.getElementById('ml-overlay')!;
  const closeBtn = document.getElementById('ml-drawer-close')!;

  function openDrawer() {
    drawer.classList.add('is-open');
    overlay.classList.add('is-active');
    menuBtn.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-active');
    menuBtn.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  menuBtn.addEventListener('click', () => drawer.classList.contains('is-open') ? closeDrawer() : openDrawer());
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

  // Buscador: en la home dispara el formulario principal; en otras páginas navega a /?q=
  const navForm = document.getElementById('ml-nav-search') as HTMLFormElement;
  navForm?.addEventListener('submit', (e) => {
    if (window.location.pathname === '/') {
      e.preventDefault();
      const q = (document.getElementById('ml-nav-q') as HTMLInputElement).value.trim();
      if (q.length < 2) return;
      const mainInput = document.getElementById('query') as HTMLInputElement | null;
      const mainForm  = document.getElementById('search-form') as HTMLFormElement | null;
      if (mainInput && mainForm) {
        mainInput.value = q;
        mainForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      }
    }
  });
</script>

<style>
  /* ── Barra ── */
  .ml-nav {
    position: sticky;
    top: 0;
    z-index: 300;
    background: #fff;
    border-bottom: 1px solid #e3d9c8;
    box-shadow: 0 1px 6px rgba(0,0,0,0.07);
  }
  .ml-nav__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Logo */
  .ml-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: #0e6a45;
    font-family: Fraunces, serif;
    font-size: 1rem;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .ml-nav__brand img { border-radius: 5px; vertical-align: middle; }
  .ml-nav__brand strong { font-weight: 700; }

  /* ≡ Menú */
  .ml-nav__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    background: none;
    font-size: 0.82rem;
    font-weight: 700;
    color: #1d1a16;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.12s, background 0.12s, color 0.12s;
    white-space: nowrap;
  }
  .ml-nav__menu-btn:hover,
  .ml-nav__menu-btn[aria-expanded="true"] {
    border-color: #0e6a45;
    background: #f0faf5;
    color: #0e6a45;
  }

  /* Buscador */
  .ml-nav__search {
    flex: 1;
    display: flex;
    align-items: center;
    border: 1.5px solid #d1d5db;
    border-radius: 999px;
    overflow: hidden;
    background: #fafafa;
    transition: border-color 0.15s, box-shadow 0.15s;
    min-width: 0;
  }
  .ml-nav__search:focus-within {
    border-color: #0e6a45;
    box-shadow: 0 0 0 3px rgba(14,106,69,0.1);
    background: #fff;
  }
  .ml-search-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.42rem 0.85rem;
    font-size: 0.85rem;
    background: transparent;
    min-width: 0;
    font-family: inherit;
  }
  .ml-search-btn {
    padding: 0.38rem 0.8rem;
    background: #0e6a45;
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .ml-search-btn:hover { background: #0a5236; }

  /* Acciones derechas */
  .ml-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .ml-nav__action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border: none;
    border-radius: 8px;
    background: none;
    font-size: 0.8rem;
    font-weight: 500;
    color: #1d1a16;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.12s, color 0.12s;
    position: relative;
  }
  .ml-nav__action-btn:hover { background: #f0faf5; color: #0e6a45; }

  .ml-cart-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0e6a45;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    line-height: 1;
    flex-shrink: 0;
  }

  /* Auth */
  .ml-nav__auth { display: flex; align-items: center; }

  .ml-nav__login-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    background: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1d1a16;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.12s, background 0.12s;
  }
  .ml-nav__login-btn:hover { border-color: #4285F4; background: #f0f4ff; }

  .ml-nav__user {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
  }
  .ml-nav__username {
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    color: #0e6a45;
    text-decoration: none;
  }
  .ml-nav__username:hover { text-decoration: underline; }
  .ml-nav__perfil-link {
    color: #555;
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    transition: background 0.1s;
  }
  .ml-nav__perfil-link:hover { background: #f3f4f6; color: #111; }
  .ml-nav__logout {
    border: none;
    background: none;
    color: #888;
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    white-space: nowrap;
    transition: background 0.1s, color 0.1s;
  }
  .ml-nav__logout:hover { background: #fef2f2; color: #dc2626; }

  /* Ocultar labels en pantallas pequeñas */
  @media (max-width: 600px) {
    .ml-action-label { display: none; }
    .ml-menu-label   { display: none; }
    .ml-nav__ia      { display: none; }
    .ml-nav__perfil-link { display: none; }
    .ml-nav__username { max-width: 60px; }
  }

  /* ── Overlay ── */
  .ml-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 400;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(1px);
  }
  .ml-overlay.is-active { display: block; }

  /* ── Drawer ── */
  .ml-drawer {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    z-index: 500;
    width: min(300px, 85vw);
    background: #fff;
    box-shadow: 4px 0 28px rgba(0,0,0,0.16);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.24s cubic-bezier(0.4,0,0.2,1);
  }
  .ml-drawer.is-open { transform: translateX(0); }

  .ml-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem 0.9rem;
    border-bottom: 2px solid #0e6a45;
  }
  .ml-drawer__greeting {
    font-family: Fraunces, serif;
    font-size: 1.1rem;
    font-weight: 640;
    color: #0e6a45;
  }
  .ml-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    color: #555;
    border-radius: 6px;
    display: flex;
    align-items: center;
    transition: background 0.1s, color 0.1s;
  }
  .ml-drawer__close:hover { background: #f3f4f6; color: #111; }

  .ml-drawer__list {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .ml-drawer__link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.25rem;
    text-decoration: none;
    color: #1d1a16;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid #f5f5f5;
    transition: background 0.1s, color 0.1s;
  }
  .ml-drawer__link:hover,
  .ml-drawer__link--on { background: #f0faf5; color: #0e6a45; }
  .ml-drawer__ico  { font-size: 1.25rem; flex-shrink: 0; line-height: 1; }
  .ml-drawer__name { flex: 1; }
  .ml-drawer__arrow { flex-shrink: 0; color: #bbb; transition: color 0.1s; }
  .ml-drawer__link:hover .ml-drawer__arrow,
  .ml-drawer__link--on  .ml-drawer__arrow { color: #0e6a45; }

  .ml-drawer__footer {
    padding: 0.9rem 1.25rem;
    border-top: 1px solid #f0f0f0;
  }
  .ml-drawer__all {
    font-size: 0.85rem;
    color: #0e6a45;
    text-decoration: none;
    font-weight: 600;
  }
  .ml-drawer__all:hover { text-decoration: underline; }
</style>
