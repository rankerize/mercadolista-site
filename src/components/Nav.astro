---
import { CATEGORIES } from '../lib/catalog';
const pathname = Astro.url.pathname;
---

<nav class="ml-nav" aria-label="Navegación principal">
  <div class="ml-nav__inner">
    <a href="/" class="ml-nav__brand">
      <img src="/logo.png" alt="Mercado Lista" width="26" height="26" style="border-radius: 6px; vertical-align: middle; margin-right: 0.45rem; display: inline-block;" />
      <span>Mercado Lista</span>
    </a>

    <ul class="ml-nav__desktop" role="list">
      <li>
        <a
          href="/asistente"
          class:list={['ml-nav__link', { 'ml-nav__link--on': pathname === '/asistente' }]}
          style="color: #0e6a45; font-weight: 600; background: #e7f6ee;"
        >
          <span aria-hidden="true">🧑‍🍳</span>
          <span>Asistente IA</span>
        </a>
      </li>
      {CATEGORIES.map((c) => (
        <li>
          <a
            href={`/categoria/${c.id}`}
            class:list={['ml-nav__link', { 'ml-nav__link--on': pathname.startsWith(`/categoria/${c.id}`) }]}
          >
            <span aria-hidden="true">{c.icono}</span>
            <span>{c.nombre.split(' ')[0]}</span>
          </a>
        </li>
      ))}
    </ul>

    <button
      class="ml-nav__toggle"
      id="ml-nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="ml-nav-mobile"
    >
      <span class="ml-nav__bar"></span>
      <span class="ml-nav__bar"></span>
      <span class="ml-nav__bar"></span>
    </button>
  </div>

  <div class="ml-nav__mobile" id="ml-nav-mobile" hidden>
    <ul role="list">
      <li style="grid-column: 1 / -1;">
        <a
          href="/asistente"
          class:list={['ml-nav__mob-link', { 'ml-nav__mob-link--on': pathname === '/asistente' }]}
          style="background: #e7f6ee; color: #0e6a45; font-weight: 600;"
        >
          <span class="ml-nav__mob-ico" aria-hidden="true">🧑‍🍳</span>
          <span>Asistente de Compras & Recetas IA</span>
        </a>
      </li>
      {CATEGORIES.map((c) => (
        <li>
          <a
            href={`/categoria/${c.id}`}
            class:list={['ml-nav__mob-link', { 'ml-nav__mob-link--on': pathname.startsWith(`/categoria/${c.id}`) }]}
          >
            <span class="ml-nav__mob-ico" aria-hidden="true">{c.icono}</span>
            <span>{c.nombre}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('ml-nav-toggle')!;
  const menu   = document.getElementById('ml-nav-mobile')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Abrir menú' : 'Cerrar menú');
    open ? menu.setAttribute('hidden', '') : menu.removeAttribute('hidden');
  });

  menu.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú');
    }),
  );

  document.addEventListener('click', (e) => {
    if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .ml-nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: #fff;
    border-bottom: 1px solid var(--line, #e3d9c8);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
  }

  .ml-nav__inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 50px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ml-nav__brand {
    font-family: Fraunces, serif;
    font-weight: 640;
    font-size: 1rem;
    color: var(--pine, #0e6a45);
    text-decoration: none;
    flex-shrink: 0;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* ── Desktop nav ── */
  .ml-nav__desktop {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.1rem;
    align-items: center;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ml-nav__desktop::-webkit-scrollbar { display: none; }

  .ml-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink, #1d1a16);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.12s, color 0.12s;
  }
  .ml-nav__link:hover,
  .ml-nav__link--on {
    background: var(--stamp, #e7f6ee);
    color: var(--pine, #0e6a45);
  }

  /* ── Hamburger ── */
  .ml-nav__toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 18px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
    flex-shrink: 0;
  }
  .ml-nav__bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink, #1d1a16);
    border-radius: 2px;
  }

  /* ── Mobile menu ── */
  .ml-nav__mobile {
    background: #fff;
    border-top: 1px solid var(--line, #e3d9c8);
  }
  .ml-nav__mobile ul {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 0.5rem;
  }
  .ml-nav__mob-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink, #1d1a16);
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.1s;
  }
  .ml-nav__mob-link:hover,
  .ml-nav__mob-link--on {
    background: var(--stamp, #e7f6ee);
    color: var(--pine, #0e6a45);
  }
  .ml-nav__mob-ico { font-size: 1.25rem; flex-shrink: 0; }

  @media (min-width: 700px) {
    .ml-nav__desktop { display: flex; }
    .ml-nav__toggle  { display: none; }
  }
</style>
