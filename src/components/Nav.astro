---
import { CATEGORIES } from '../lib/catalog';
const pathname = Astro.url.pathname;
---

<!-- Barra principal -->
<nav class="ml-nav" aria-label="Navegación principal">
  <div class="ml-nav__inner">
    <a href="/" class="ml-nav__brand">
      <img src="/logo.png" alt="Mercado Lista" width="28" height="28" />
      <span>Mercado<strong>Lista</strong></span>
    </a>

    <button
      class="ml-nav__menu-btn"
      id="ml-menu-btn"
      aria-expanded="false"
      aria-controls="ml-drawer"
      aria-label="Abrir menú de categorías"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <rect width="18" height="2" rx="1" fill="currentColor"/>
        <rect y="6" width="18" height="2" rx="1" fill="currentColor"/>
        <rect y="12" width="18" height="2" rx="1" fill="currentColor"/>
      </svg>
      <span>Menú</span>
    </button>

    <form class="ml-nav__search" id="ml-nav-search" role="search" action="/" method="get">
      <input
        type="search"
        name="q"
        id="ml-nav-q"
        class="ml-search-input"
        placeholder="Buscar productos..."
        autocomplete="off"
        aria-label="Buscar productos"
      />
      <button type="submit" class="ml-search-btn" aria-label="Buscar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </form>
  </div>
</nav>

<!-- Overlay oscuro -->
<div class="ml-overlay" id="ml-overlay" aria-hidden="true"></div>

<!-- Drawer lateral izquierdo -->
<aside class="ml-drawer" id="ml-drawer" aria-label="Menú de categorías" aria-hidden="true">
  <div class="ml-drawer__head">
    <span class="ml-drawer__greeting">Categorías</span>
    <button class="ml-drawer__close" id="ml-drawer-close" aria-label="Cerrar menú">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <ul class="ml-drawer__list" role="list">
    {CATEGORIES.map((c) => (
      <li>
        <a
          href={`/categoria/${c.id}`}
          class:list={['ml-drawer__link', { 'ml-drawer__link--on': pathname.startsWith(`/categoria/${c.id}`) }]}
        >
          <span class="ml-drawer__ico" aria-hidden="true">{c.icono}</span>
          <span class="ml-drawer__name">{c.nombre}</span>
          <svg class="ml-drawer__arrow" width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 1 7 7 1 13"/>
          </svg>
        </a>
      </li>
    ))}
  </ul>

  <div class="ml-drawer__footer">
    <a href="/categoria" class="ml-drawer__all">Ver todas las categorías →</a>
  </div>
</aside>

<script>
  const menuBtn  = document.getElementById('ml-menu-btn')!;
  const drawer   = document.getElementById('ml-drawer')!;
  const overlay  = document.getElementById('ml-overlay')!;
  const closeBtn = document.getElementById('ml-drawer-close')!;

  function openDrawer() {
    drawer.classList.add('is-open');
    overlay.classList.add('is-active');
    menuBtn.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-active');
    menuBtn.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  menuBtn.addEventListener('click', () =>
    drawer.classList.contains('is-open') ? closeDrawer() : openDrawer()
  );
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

  // Buscador: en la home redirige al input principal; en otras páginas hace GET /?q=...
  const navForm = document.getElementById('ml-nav-search') as HTMLFormElement;
  navForm?.addEventListener('submit', (e) => {
    if (window.location.pathname === '/') {
      e.preventDefault();
      const q = (document.getElementById('ml-nav-q') as HTMLInputElement).value.trim();
      if (q.length < 2) return;
      const mainInput = document.getElementById('query') as HTMLInputElement | null;
      const mainForm  = document.getElementById('search-form') as HTMLFormElement | null;
      if (mainInput && mainForm) {
        mainInput.value = q;
        mainForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      }
    }
  });
</script>

<style>
  /* ── Barra ── */
  .ml-nav {
    position: sticky;
    top: 0;
    z-index: 300;
    background: #fff;
    border-bottom: 1px solid #e3d9c8;
    box-shadow: 0 1px 6px rgba(0,0,0,0.07);
  }

  .ml-nav__inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Logo */
  .ml-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: #0e6a45;
    font-family: Fraunces, serif;
    font-size: 1.05rem;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .ml-nav__brand img { border-radius: 5px; }
  .ml-nav__brand strong { font-weight: 700; }

  /* ≡ Menú */
  .ml-nav__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border: 1.5px solid #ccc;
    border-radius: 8px;
    background: none;
    font-size: 0.875rem;
    font-weight: 700;
    color: #1d1a16;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.12s, background 0.12s;
    white-space: nowrap;
  }
  .ml-nav__menu-btn:hover,
  .ml-nav__menu-btn[aria-expanded="true"] {
    border-color: #0e6a45;
    background: #f0faf5;
    color: #0e6a45;
  }

  /* Buscador */
  .ml-nav__search {
    flex: 1;
    display: flex;
    align-items: center;
    border: 1.5px solid #ccc;
    border-radius: 999px;
    overflow: hidden;
    background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s;
    min-width: 0;
  }
  .ml-nav__search:focus-within {
    border-color: #0e6a45;
    box-shadow: 0 0 0 3px rgba(14,106,69,0.1);
  }
  .ml-search-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.45rem 0.9rem;
    font-size: 0.875rem;
    background: transparent;
    min-width: 0;
    font-family: inherit;
  }
  .ml-search-btn {
    padding: 0.38rem 0.85rem;
    background: #0e6a45;
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .ml-search-btn:hover { background: #0a5236; }

  /* ── Overlay ── */
  .ml-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 400;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(1px);
  }
  .ml-overlay.is-active { display: block; }

  /* ── Drawer ── */
  .ml-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 500;
    width: min(300px, 85vw);
    background: #fff;
    box-shadow: 4px 0 28px rgba(0,0,0,0.16);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.24s cubic-bezier(0.4,0,0.2,1);
  }
  .ml-drawer.is-open { transform: translateX(0); }

  .ml-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem 0.9rem;
    border-bottom: 2px solid #0e6a45;
  }
  .ml-drawer__greeting {
    font-family: Fraunces, serif;
    font-size: 1.1rem;
    font-weight: 640;
    color: #0e6a45;
  }
  .ml-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    color: #555;
    border-radius: 6px;
    display: flex;
    align-items: center;
    transition: background 0.1s, color 0.1s;
  }
  .ml-drawer__close:hover { background: #f3f4f6; color: #111; }

  .ml-drawer__list {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .ml-drawer__link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.25rem;
    text-decoration: none;
    color: #1d1a16;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid #f5f5f5;
    transition: background 0.1s, color 0.1s;
  }
  .ml-drawer__link:hover,
  .ml-drawer__link--on {
    background: #f0faf5;
    color: #0e6a45;
  }
  .ml-drawer__ico  { font-size: 1.25rem; flex-shrink: 0; line-height: 1; }
  .ml-drawer__name { flex: 1; }
  .ml-drawer__arrow { flex-shrink: 0; color: #bbb; transition: color 0.1s; }
  .ml-drawer__link:hover .ml-drawer__arrow,
  .ml-drawer__link--on .ml-drawer__arrow { color: #0e6a45; }

  .ml-drawer__footer {
    padding: 0.9rem 1.25rem;
    border-top: 1px solid #f0f0f0;
  }
  .ml-drawer__all {
    font-size: 0.85rem;
    color: #0e6a45;
    text-decoration: none;
    font-weight: 600;
  }
  .ml-drawer__all:hover { text-decoration: underline; }
</style>
