---
// src/components/CameraSearchModal.astro
---

<div id="camera-search-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="camera-modal-title">
  <div class="modal-card camera-modal-card">
    <button type="button" class="modal-close" id="camera-modal-close" aria-label="Cerrar modal">✕</button>

    <div class="camera-modal-head">
      <div class="camera-modal-icon-badge">📷</div>
      <div>
        <h2 id="camera-modal-title" class="modal-title">Buscador por Imagen y Código de Barras</h2>
        <p class="modal-lead">Identifica productos con IA o escanea su código para comparar precios en Colombia.</p>
      </div>
    </div>

    <!-- Pestañas de modo -->
    <div class="camera-tabs" role="tablist">
      <button type="button" id="tab-cam-photo" class="camera-tab is-active" role="tab" aria-selected="true">
        📸 Foto de empaque / producto
      </button>
      <button type="button" id="tab-cam-barcode" class="camera-tab" role="tab" aria-selected="false">
        🏷️ Escáner de código de barras
      </button>
    </div>

    <!-- ============================================== -->
    <!-- PANEL 1: FOTO DEL EMPAQUE CON IA (GEMINI)      -->
    <!-- ============================================== -->
    <div id="panel-cam-photo" class="camera-panel">
      <!-- Zona de subida / captura -->
      <div id="camera-dropzone" class="camera-dropzone">
        <input
          type="file"
          id="camera-file-input"
          accept="image/*"
          capture="environment"
          class="camera-file-input"
          aria-label="Seleccionar imagen o tomar foto"
        />

        <div class="camera-dropzone-content">
          <div class="camera-upload-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
          </div>
          <p class="camera-dropzone-title">Toma una foto o sube una imagen</p>
          <p class="camera-dropzone-subtitle">Foto del tarro, caja, bolsa o etiqueta de tu alacena</p>
          <button type="button" id="btn-trigger-file" class="btn-primary camera-cta-btn">
            📷 Abrir cámara / Subir foto
          </button>
          <span class="camera-dropzone-hint">En computador puedes arrastrar la imagen o presionar Ctrl+V</span>
        </div>
      </div>

      <!-- Estado: Cargando análisis de IA -->
      <div id="camera-loading" class="camera-status-box" hidden>
        <div class="camera-spinner"></div>
        <p class="camera-loading-title">Analizando producto con IA...</p>
        <p class="camera-loading-sub">Identificando marca, empaque y presentación para comparar en tiendas</p>
      </div>

      <!-- Estado: Error / Fallback -->
      <div id="camera-error" class="camera-error-box" hidden>
        <div class="camera-error-icon">⚠️</div>
        <p id="camera-error-msg" class="camera-error-text">No se pudo identificar la imagen.</p>
        <button type="button" id="btn-retry-photo" class="ghost" style="margin-top: 0.5rem;">
          Intentar con otra foto
        </button>
      </div>

      <!-- Estado: Resultado identificado con éxito -->
      <div id="camera-result" class="camera-result-card" hidden>
        <div class="camera-result-preview-row">
          <img id="camera-result-img" class="camera-result-thumb" alt="Vista previa" src="" />
          <div class="camera-result-details">
            <span id="camera-result-category" class="camera-result-badge">Lácteos</span>
            <h3 id="camera-result-name" class="camera-result-title">Nombre del Producto</h3>
            <p id="camera-result-meta" class="camera-result-meta">Marca: — · Presentación: —</p>
            <p id="camera-result-hint" class="camera-result-hint">Búsqueda sugerida: <code id="camera-result-query">...</code></p>
          </div>
        </div>

        <div class="camera-result-actions">
          <button type="button" id="btn-search-detected" class="btn-primary camera-action-primary">
            🔍 Comparar precios en tiendas
          </button>
          <button type="button" id="btn-add-to-list-detected" class="btn-secondary camera-action-secondary">
            ➕ Añadir a mi lista de compras
          </button>
          <button type="button" id="btn-another-photo" class="ghost">
            Tomar otra foto
          </button>
        </div>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- PANEL 2: ESCÁNER DE CÓDIGO DE BARRAS (EAN)     -->
    <!-- ============================================== -->
    <div id="panel-cam-barcode" class="camera-panel" hidden>
      <div class="barcode-container">
        <!-- Viewport de video en vivo -->
        <div id="barcode-viewport" class="barcode-viewport">
          <video id="barcode-video" class="barcode-video" playsinline muted autoplay></video>
          <div class="barcode-overlay">
            <div class="barcode-laser"></div>
            <div class="barcode-corners">
              <span class="c-tl"></span>
              <span class="c-tr"></span>
              <span class="c-bl"></span>
              <span class="c-br"></span>
            </div>
          </div>
          <div id="barcode-cam-prompt" class="barcode-cam-prompt">
            <span>Centra el código de barras en el recuadro</span>
          </div>
        </div>

        <div class="barcode-controls">
          <button type="button" id="btn-start-scanner" class="btn-primary" style="width: 100%;">
            📹 Iniciar cámara para escanear
          </button>
          <button type="button" id="btn-stop-scanner" class="ghost" style="width: 100%;" hidden>
            ⏹ Detener cámara
          </button>
        </div>

        <!-- Entrada manual de números de código de barras -->
        <div class="barcode-manual-row">
          <label for="barcode-manual-input" class="modal-label">O escribe los dígitos del código (EAN/UPC):</label>
          <div class="barcode-input-group">
            <input
              type="text"
              id="barcode-manual-input"
              class="add-modal-input"
              placeholder="Ej. 7702129001052"
              pattern="[0-9]*"
              inputmode="numeric"
            />
            <button type="button" id="btn-lookup-barcode" class="btn-primary" style="white-space: nowrap;">
              Buscar
            </button>
          </div>
        </div>

        <!-- Feedback de escaneo / carga -->
        <div id="barcode-status" class="camera-status-box" hidden>
          <div class="camera-spinner"></div>
          <p id="barcode-status-text" class="camera-loading-title">Consultando código de barras...</p>
        </div>

        <!-- Resultado de código de barras -->
        <div id="barcode-result" class="camera-result-card" hidden>
          <div class="camera-result-preview-row">
            <div id="barcode-result-icon" class="barcode-result-icon">📦</div>
            <div class="camera-result-details">
              <span id="barcode-result-badge" class="camera-result-badge">EAN-13</span>
              <h3 id="barcode-result-name" class="camera-result-title">Producto detectado</h3>
              <p id="barcode-result-meta" class="camera-result-meta">Código: —</p>
            </div>
          </div>

          <div class="camera-result-actions">
            <button type="button" id="btn-search-barcode" class="btn-primary camera-action-primary">
              🔍 Comparar precios en tiendas
            </button>
            <button type="button" id="btn-add-barcode-list" class="btn-secondary camera-action-secondary">
              ➕ Añadir a mi lista de compras
            </button>
            <button type="button" id="btn-scan-another" class="ghost">
              Escanear otro
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
