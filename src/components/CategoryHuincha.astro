---
// src/components/CategoryHuincha.astro
// Huincha superior de navegación por subcategorías / marcas tipo retail (Falabella / referencia)

export interface HuinchaItem {
  id: string;
  name: string;
  url: string;
  countStr?: string;
  emoji?: string;
  iconType?: string;
  isActive?: boolean;
}

export interface Props {
  kicker?: string;
  subtitle?: string;
  items: HuinchaItem[];
}

const {
  kicker = 'LÍNEAS Y MARCAS DESTACADAS',
  subtitle = 'Navegue entre nuestras familias oficiales con envíos a toda Colombia y comparación en vivo',
  items = [],
} = Astro.props;
---

{items.length > 0 && (
  <section class="huincha-section" aria-label="Familias y subcategorías destacadas">
    <div class="huincha-header">
      <div class="huincha-kicker-wrap">
        <span class="huincha-badge-pill">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{kicker} ({items.length} FAMILIAS)</span>
        </span>
      </div>
      <p class="huincha-subtitle">{subtitle}</p>
    </div>

    <div class="huincha-carousel-wrap">
      <button
        type="button"
        class="huincha-arrow huincha-arrow--prev"
        aria-label="Desplazar subcategorías hacia la izquierda"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="huincha-track" role="list">
        {items.map((item) => (
          <a
            href={item.url}
            class={`huincha-card ${item.isActive ? 'huincha-card--active' : ''}`}
            role="listitem"
            title={`Ver ofertas en ${item.name}`}
          >
            <div class="huincha-card-visual">
              {item.emoji ? (
                <span class="huincha-card-emoji" aria-hidden="true">{item.emoji}</span>
              ) : (
                <>
                  {/* Apple / iPhone */}
                  {item.iconType === 'apple' && (
                    <svg viewBox="0 0 32 32" width="34" height="34" fill="currentColor">
                      <path d="M22.5 17.4c0-3.3 2.7-4.9 2.8-5-1.5-2.3-3.9-2.6-4.7-2.7-2-.2-3.9 1.2-4.9 1.2s-2.6-1.2-4.2-1.2c-2.2 0-4.2 1.3-5.3 3.3-2.3 4-0.6 10 1.7 13.2 1.1 1.6 2.4 3.4 4.1 3.3 1.7-.1 2.3-1.1 4.3-1.1s2.6 1.1 4.4 1.1c1.8 0 3-1.6 4.1-3.2 1.3-1.9 1.8-3.7 1.9-3.8-0.1-.1-3.5-1.4-3.5-5.1zM18.8 7.3c0.9-1.1 1.5-2.6 1.3-4.1-1.3 0.1-2.8 0.9-3.7 1.9-0.8 0.9-1.5 2.5-1.3 4 1.4 0.1 2.8-0.7 3.7-1.8z" />
                    </svg>
                  )}

                  {/* Samsung Galaxy */}
                  {item.iconType === 'samsung' && (
                    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
                      <rect x="11" y="4" width="18" height="32" rx="4.5" fill="#0f172a" />
                      <rect x="12.5" y="6" width="15" height="28" rx="3" fill="#1e3a8a" />
                      <circle cx="20" cy="8.5" r="1.2" fill="#60a5fa" />
                      <rect x="15" y="15" width="10" height="2" rx="1" fill="#93c5fd" opacity="0.8" />
                      <rect x="15" y="19" width="7" height="1.5" rx="0.75" fill="#60a5fa" opacity="0.6" />
                    </svg>
                  )}

                  {/* Xiaomi */}
                  {item.iconType === 'xiaomi' && (
                    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
                      <rect x="6" y="6" width="28" height="28" rx="8" fill="#ea580c" />
                      <path d="M14 13h4v14h-4z M22 13h4v7h-4z M22 23h4v4h-4z" fill="#fff" />
                    </svg>
                  )}

                  {/* Motorola */}
                  {item.iconType === 'motorola' && (
                    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
                      <circle cx="20" cy="20" r="15" fill="#0284c7" />
                      <path d="M12 25c2-6 5-11 8-4 3-7 6-2 8 4-2-4-5-8-8-2-3-6-6-2-8 2z" fill="#fff" />
                    </svg>
                  )}

                  {/* Smartwatch */}
                  {item.iconType === 'smartwatch' && (
                    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
                      <rect x="16" y="3" width="8" height="6" rx="1" fill="#64748b" />
                      <rect x="16" y="31" width="8" height="6" rx="1" fill="#64748b" />
                      <rect x="10" y="8" width="20" height="24" rx="6" fill="#0f172a" stroke="#334155" stroke-width="1.5" />
                      <circle cx="20" cy="20" r="7" fill="#10b981" opacity="0.25" />
                      <circle cx="20" cy="20" r="6" stroke="#34d399" stroke-width="1.5" stroke-dasharray="28 8" />
                      <circle cx="20" cy="20" r="1.5" fill="#fff" />
                      <line x1="20" y1="20" x2="20" y2="16" stroke="#fff" stroke-width="1.2" stroke-linecap="round" />
                      <line x1="20" y1="20" x2="23" y2="20" stroke="#f59e0b" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                  )}

                  {/* Audífonos TWS / Bluetooth */}
                  {item.iconType === 'audifonos' && (
                    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
                      <rect x="11" y="11" width="18" height="20" rx="6" fill="#1e293b" />
                      <rect x="12" y="12" width="16" height="7" rx="3.5" fill="#334155" />
                      <circle cx="20" cy="22" r="1.5" fill="#10b981" />
                      {/* Auricular izquierdo */}
                      <circle cx="7" cy="18" r="4" fill="#64748b" />
                      <rect x="8" y="18" width="2" height="9" rx="1" fill="#94a3b8" />
                      {/* Auricular derecho */}
                      <circle cx="33" cy="18" r="4" fill="#64748b" />
                      <rect x="30" y="18" width="2" height="9" rx="1" fill="#94a3b8" />
                    </svg>
                  )}

                  {/* Accesorios / Cargador */}
                  {item.iconType === 'accesorios' && (
                    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
                      <rect x="12" y="12" width="16" height="18" rx="4" fill="#334155" />
                      <rect x="15" y="5" width="2.5" height="7" rx="0.5" fill="#94a3b8" />
                      <rect x="22.5" y="5" width="2.5" height="7" rx="0.5" fill="#94a3b8" />
                      <circle cx="20" cy="21" r="3.5" fill="#10b981" opacity="0.4" />
                      <path d="M19 18l-1.5 3.5h2.5L19 25" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}

                  {/* Genérico / Teléfono */}
                  {(!item.iconType || item.iconType === 'phone' || item.iconType === 'honor' || item.iconType === 'generic') && (
                    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
                      <rect x="12" y="5" width="16" height="30" rx="4.5" fill="#1e293b" stroke="#475569" stroke-width="1.5" />
                      <rect x="14" y="7" width="12" height="24" rx="2.5" fill="url(#huincha-grad-phone)" />
                      <circle cx="20" cy="8.5" r="0.9" fill="#0f172a" />
                      <rect x="17.5" y="32" width="5" height="1" rx="0.5" fill="#94a3b8" />
                      <defs>
                        <linearGradient id="huincha-grad-phone" x1="14" y1="7" x2="26" y2="31" gradientUnits="userSpaceOnUse">
                          <stop stop-color="#06b6d4" />
                          <stop offset="0.5" stop-color="#3b82f6" />
                          <stop offset="1" stop-color="#8b5cf6" />
                        </linearGradient>
                      </defs>
                    </svg>
                  )}
                </>
              )}
            </div>

            <div class="huincha-card-meta">
              <span class="huincha-card-name">{item.name}</span>
              {item.countStr && <span class="huincha-card-count">{item.countStr}</span>}
            </div>
          </a>
        ))}
      </div>

      <button
        type="button"
        class="huincha-arrow huincha-arrow--next"
        aria-label="Desplazar subcategorías hacia la derecha"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </section>
)}

<script>
  function setupHuinchaCarousels() {
    document.querySelectorAll('.huincha-carousel-wrap').forEach((wrap) => {
      const track = wrap.querySelector<HTMLElement>('.huincha-track');
      const prevBtn = wrap.querySelector<HTMLButtonElement>('.huincha-arrow--prev');
      const nextBtn = wrap.querySelector<HTMLButtonElement>('.huincha-arrow--next');
      if (!track || !prevBtn || !nextBtn) return;

      const scrollStep = 280;

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollStep, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollStep, behavior: 'smooth' });
      });

      function updateButtons() {
        if (!track || !prevBtn || !nextBtn) return;
        const maxScroll = track.scrollWidth - track.clientWidth - 2;
        prevBtn.style.opacity = track.scrollLeft <= 4 ? '0.35' : '1';
        prevBtn.style.pointerEvents = track.scrollLeft <= 4 ? 'none' : 'auto';
        nextBtn.style.opacity = track.scrollLeft >= maxScroll ? '0.35' : '1';
        nextBtn.style.pointerEvents = track.scrollLeft >= maxScroll ? 'none' : 'auto';
      }

      track.addEventListener('scroll', updateButtons, { passive: true });
      updateButtons();

      // Arrastre con mouse en escritorio sin bloquear los clics en los enlaces
      let isDown = false;
      let startX = 0;
      let startScrollLeft = 0;
      let hasDragged = false;
      let justDragged = false;

      track.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return; // Solo botón izquierdo
        isDown = true;
        hasDragged = false;
        justDragged = false;
        startX = e.pageX;
        startScrollLeft = track.scrollLeft;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        const diff = e.pageX - startX;
        // Solo considerar arrastre si supera un umbral claro de movimiento (10px)
        if (Math.abs(diff) > 10) {
          hasDragged = true;
          justDragged = true;
          track.classList.add('is-dragging');
          track.scrollLeft = startScrollLeft - diff;
        }
      });

      window.addEventListener('mouseup', () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
        if (hasDragged) {
          // Mantener el bloqueo de clic brevemente tras soltar el arrastre
          setTimeout(() => {
            justDragged = false;
            hasDragged = false;
          }, 80);
        } else {
          justDragged = false;
          hasDragged = false;
        }
      });

      // Asegurar que los clics normales naveguen siempre a la subcategoría
      track.querySelectorAll<HTMLAnchorElement>('.huincha-card').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (justDragged || hasDragged) {
            e.preventDefault();
            e.stopPropagation();
            justDragged = false;
            hasDragged = false;
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHuinchaCarousels);
  } else {
    setupHuinchaCarousels();
  }
</script>

<style>
  .huincha-section {
    margin: 0.5rem 0 2.25rem;
    padding: 1.25rem 0.5rem 1.5rem;
    background: #fbfcfd;
    border-top: 1px solid #edf2f7;
    border-bottom: 1px solid #edf2f7;
  }

  .huincha-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .huincha-kicker-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 0.4rem;
  }

  .huincha-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #e6f6ee;
    color: #0e6a45;
    border: 1px solid #b7e4cf;
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .huincha-subtitle {
    margin: 0;
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.4;
  }

  .huincha-carousel-wrap {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 100%;
  }

  .huincha-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    color: #1e293b;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.15s, background 0.15s, border-color 0.15s;
    flex-shrink: 0;
    z-index: 2;
  }

  .huincha-arrow:hover {
    background: #0e6a45;
    color: #ffffff;
    border-color: #0e6a45;
    transform: scale(1.08);
  }

  .huincha-arrow--prev {
    margin-right: 0.4rem;
  }

  .huincha-arrow--next {
    margin-left: 0.4rem;
  }

  .huincha-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 0.5rem 0.25rem 0.75rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1;
    cursor: grab;
    user-select: none;
    -webkit-overflow-scrolling: touch;
  }

  .huincha-track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .huincha-track::-webkit-scrollbar {
    display: none;
  }

  .huincha-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    width: 104px;
    flex-shrink: 0;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .huincha-card:hover {
    transform: translateY(-3px);
  }

  .huincha-card-visual {
    width: 76px;
    height: 76px;
    border-radius: 16px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    color: #334155;
    margin-bottom: 0.55rem;
  }

  .huincha-card-emoji {
    font-size: 2.15rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .huincha-card:hover .huincha-card-emoji {
    transform: scale(1.15);
  }

  .huincha-card:hover .huincha-card-visual {
    border-color: #0e6a45;
    box-shadow: 0 4px 14px rgba(14, 106, 69, 0.14);
  }

  .huincha-card--active .huincha-card-visual {
    border-color: #0e6a45;
    background: #f0faf5;
    box-shadow: 0 0 0 2px rgba(14, 106, 69, 0.2);
  }

  .huincha-card-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .huincha-card-name {
    font-size: 0.84rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .huincha-card--active .huincha-card-name {
    color: #0e6a45;
    font-weight: 700;
  }

  .huincha-card-count {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 0.2rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .huincha-card {
      width: 88px;
    }
    .huincha-card-visual {
      width: 66px;
      height: 66px;
      border-radius: 14px;
    }
    .huincha-arrow {
      display: none;
    }
  }
</style>
