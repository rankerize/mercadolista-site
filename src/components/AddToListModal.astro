---
// src/components/AddToListModal.astro
---

<div id="add-to-list-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="add-modal-title">
  <div class="modal-card">
    <button type="button" class="modal-close" id="add-modal-close" aria-label="Cerrar modal">✕</button>
    <h2 id="add-modal-title" class="modal-title">Añadir a lista de compras</h2>
    <p class="modal-lead">Guarda este producto en una lista para cotizar tu mercado completo o compartirlo.</p>

    <!-- Resumen del producto -->
    <div class="add-modal-product-summary">
      <div id="add-modal-thumb" class="add-modal-thumb"></div>
      <div class="add-modal-prod-info">
        <h3 id="add-modal-prod-name" class="add-modal-prod-title">Nombre del producto</h3>
        <p id="add-modal-prod-meta" class="add-modal-prod-meta">Tienda · Precio</p>
      </div>
    </div>

    <!-- Ajuste rápido de cantidad y formato -->
    <div class="add-modal-qty-row">
      <div class="add-modal-field">
        <label for="add-modal-qty" class="modal-label">Cantidad:</label>
        <input type="number" id="add-modal-qty" min="1" step="any" value="1" class="add-modal-input" />
      </div>
      <div class="add-modal-field">
        <label for="add-modal-format" class="modal-label">Formato:</label>
        <select id="add-modal-format" class="add-modal-select">
          <option value="unidades">Unidades</option>
          <option value="gramos">Gramos</option>
          <option value="mililitros">Mililitros</option>
        </select>
      </div>
    </div>

    <!-- 1. Estado: Usuario autenticado con listas existentes -->
    <div id="add-modal-auth-lists" class="modal-section" hidden>
      <label class="modal-label">¿Dónde quieres guardarlo?</label>
      
      <div class="add-modal-radio-group">
        <label class="add-modal-radio-label">
          <input type="radio" name="add-list-dest" value="existing" checked id="add-dest-existing" />
          <span>En una lista existente:</span>
        </label>
        <select id="add-modal-existing-select" class="add-modal-select" style="margin-left: 1.5rem; width: calc(100% - 1.5rem); margin-bottom: 0.75rem;">
          <!-- Se llena dinámicamente con las listas del usuario -->
        </select>

        <label class="add-modal-radio-label">
          <input type="radio" name="add-list-dest" value="new" id="add-dest-new" />
          <span>Crear una nueva lista:</span>
        </label>
        <input
          type="text"
          id="add-modal-new-name"
          class="add-modal-input"
          style="margin-left: 1.5rem; width: calc(100% - 1.5rem);"
          placeholder="Nombre de la nueva lista (ej: Mercado del mes)"
          disabled
        />
      </div>

      <button type="button" id="add-modal-submit-auth" class="btn-primary" style="margin-top: 1.25rem; width: 100%;">
        Guardar en lista
      </button>
    </div>

    <!-- 2. Estado: Usuario autenticado pero sin listas previas -->
    <div id="add-modal-auth-nolists" class="modal-section" hidden>
      <label class="modal-label" for="add-modal-first-name">Crear tu primera lista:</label>
      <p style="font-size: 0.85rem; color: var(--muted); margin: 0 0 0.75rem;">
        No tienes listas guardadas todavía. Escribe un nombre para crear la primera:
      </p>
      <input
        type="text"
        id="add-modal-first-name"
        class="add-modal-input"
        placeholder="Ej: Mercado de la quincena"
      />
      <button type="button" id="add-modal-submit-first" class="btn-primary" style="margin-top: 1rem; width: 100%;">
        Crear lista y agregar producto
      </button>
    </div>

    <!-- 3. Estado: Usuario anónimo / No autenticado -->
    <div id="add-modal-guest" class="modal-section" hidden>
      <p style="font-size: 0.88rem; color: var(--ink); margin: 0 0 0.85rem;">
        Elige cómo prefieres guardar este producto:
      </p>

      <button type="button" id="add-modal-add-local" class="btn-primary" style="width: 100%; margin-bottom: 0.75rem;">
        ➕ Agregar a mi canasta actual (sin cuenta)
      </button>

      <div style="display: flex; align-items: center; gap: 0.5rem; margin: 0.75rem 0; color: var(--muted); font-size: 0.8rem;">
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
        <span>o guárdalo en tu cuenta</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>

      <button type="button" id="add-modal-login-btn" class="auth-btn" style="width: 100%; justify-content: center; padding: 0.65rem 1rem;">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Iniciar sesión con Google</span>
      </button>
    </div>

    <!-- Feedback y Acciones posteriores al agregar -->
    <div id="add-modal-feedback" class="add-modal-feedback" hidden>
      <div class="feedback-success-badge">✓ ¡Agregado con éxito!</div>
      <p id="add-modal-feedback-msg" class="feedback-msg">El producto ya está en tu lista.</p>
      <div class="feedback-actions">
        <button type="button" id="add-modal-go-list" class="btn-primary">Ver lista de compras</button>
        <button type="button" id="add-modal-continue" class="ghost">Seguir comparando</button>
      </div>
    </div>
  </div>
</div>
