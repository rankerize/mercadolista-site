<script>
  // Manejador para consultar en vivo precios en tiempo real sin recargar
  document.addEventListener('DOMContentLoaded', () => {
    const liveBtn = document.querySelector<HTMLButtonElement>('#showcase-live-refresh');
    if (liveBtn) {
      liveBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        liveBtn.disabled = true;
        const originalText = liveBtn.innerHTML;
        liveBtn.innerHTML = `<span>⏳ Consultando tiendas…</span>`;

        const dealCards = document.querySelectorAll<HTMLElement>('.showcase-card');
        const citySelect = document.querySelector<HTMLSelectElement>('#city');
        const city = citySelect?.value || 'bogota';

        try {
          for (const card of Array.from(dealCards)) {
            const query = card.dataset.query;
            if (!query) continue;

            const priceNowEl = card.querySelector<HTMLElement>('.price-now');
            const winnerPill = card.querySelector<HTMLElement>('.winner-pill');

            if (priceNowEl) {
              priceNowEl.style.opacity = '0.5';
            }

            try {
              const res = await fetch(`/api/buscar?q=${encodeURIComponent(query)}&ciudad=${encodeURIComponent(city)}`);
              if (res.ok) {
                const data = await res.json();
                if (data.ganador && data.ganador.precio) {
                  if (priceNowEl) {
                    priceNowEl.textContent = `$${Number(data.ganador.precio).toLocaleString('es-CO')}`;
                    priceNowEl.style.opacity = '1';
                    priceNowEl.style.color = '#fef08a';
                  }
                  if (winnerPill && data.ganador.tienda) {
                    winnerPill.textContent = `${data.ganador.tienda} · Precio en vivo`;
                  }
                }
              }
            } catch (cardErr) {
              if (priceNowEl) priceNowEl.style.opacity = '1';
            }
          }
        } finally {
          liveBtn.disabled = false;
          liveBtn.innerHTML = `<span>✅ Actualizado</span>`;
          setTimeout(() => {
            liveBtn.innerHTML = originalText;
          }, 3000);
        }
      });
    }
  });
</script>
