---
import '../../styles/styles.css';
import { CATEGORIES } from '../../lib/catalog';
import { getTaxNode, getTaxChildren, getBreadcrumb } from '../../lib/taxonomy';
import { getItemBySlug } from '../../lib/slugs';
import {
  getCollectionNode,
  getHuinchaNavigation,
  getCollectionSeo,
  getCollectionBreadcrumbItems,
} from '../../lib/collectionTaxonomy';
import { searchStores } from '../../lib/providers';
import { buildReport } from '../../lib/ranking';
import { findCity } from '../../lib/cities';
import { cop } from '../../lib/normalize';
import Nav from '../../components/Nav.astro';
import AddToListModal from '../../components/AddToListModal.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import CategoryHuincha, { type HuinchaItem } from '../../components/CategoryHuincha.astro';
import CategorySeoFaq from '../../components/CategorySeoFaq.astro';

const { slug } = Astro.params;
let segments = (slug ?? '').split('/').filter(Boolean);

// Aliases amigables directos para tecnología y celulares
const ALIAS_PREFIXES: Record<string, string> = {
  'celulares': 'tecnologia/telefonia/celulares-y-telefonos',
  'celulares-y-telefonos': 'tecnologia/telefonia/celulares-y-telefonos',
  'smartphones': 'tecnologia/telefonia/celulares-y-telefonos/smartphones',
  'televisores': 'tecnologia/televisores-y-video',
  'laptops': 'tecnologia/computadores',
  'portatiles': 'tecnologia/computadores',
  'audifonos': 'tecnologia/audio',
  'freidoras-de-aire': 'electrohogar/electrodomesticos-cocina',
};

if (segments.length >= 1 && ALIAS_PREFIXES[segments[0]]) {
  const targetPrefix = ALIAS_PREFIXES[segments[0]];
  const rest = segments.slice(1).join('/');
  const targetUrl = rest ? `/categoria/${targetPrefix}/${rest}` : `/categoria/${targetPrefix}`;
  return Astro.redirect(targetUrl, 301);
}

// Redirigir si el slug está vacío
if (segments.length < 2) {
  return Astro.redirect('/categoria', 302);
}

const catId   = segments[0];
const taxPath = segments.join('/');

const collNode = getCollectionNode(taxPath);

let cat = CATEGORIES.find((c) => c.id === catId);
if (!cat && collNode) {
  const rootNode = getCollectionNode(collNode.rootSlug);
  cat = {
    id: collNode.rootSlug,
    nombre: rootNode ? rootNode.name : collNode.breadcrumb[0] || collNode.name,
    icono: rootNode?.icono || '🏷️',
    descripcion: `Compara precios en tiendas de Colombia`,
    color: '#0e6a45',
  };
}
if (!cat) return Astro.redirect('/categoria', 302);

let node: any = getTaxNode(taxPath);
if (!node && collNode) {
  const seo = getCollectionSeo(collNode);
  node = {
    id: collNode.id,
    nombre: collNode.name,
    icono: collNode.icono || '🏷️',
    query: collNode.query || collNode.name.toLowerCase(),
    titleSeo: seo.titleSeo,
    metaDesc: seo.metaDesc,
    h1: seo.h1,
    childIds: collNode.childIds,
    level: collNode.level,
  };
}

if (!node && !collNode && segments.length === 2) {
  const legacyItem = getItemBySlug(segments[0], segments[1]);
  if (legacyItem) {
    node = {
      id: segments.join('/'),
      nombre: legacyItem.nombre,
      icono: legacyItem.icono,
      query: legacyItem.nombre,
      titleSeo: `Precio de ${legacyItem.nombre} en Colombia hoy · Mercado Lista`,
      metaDesc: `¿Dónde comprar ${legacyItem.nombre} más barato en Colombia? Compara precios en tiempo real.`,
      h1: `${legacyItem.icono} Precio de ${legacyItem.nombre} en Colombia`,
      childIds: [],
      level: 2,
    };
  }
}

if (!node) return Astro.redirect(`/categoria/${catId}`, 302);

const children = getTaxChildren(taxPath);
const isLeaf   = collNode ? collNode.childIds.length === 0 : children.length === 0;

const BASE         = 'https://mercadolista.com';
const canonicalUrl = `${BASE}/categoria/${collNode ? collNode.slugPath : taxPath}`;
const ciudadParam  = Astro.url.searchParams.get('ciudad') || 'bogota';
const city         = findCity(ciudadParam);

// Consultar precios en tiempo real para cualquier nodo con query asignado
// Timeout protector de 4s para SSR veloz: si tarda más, el cliente hidrata en vivo
let report: Record<string, any> | null = null;
let errorMsg: string | null = null;

if (node.query) {
  try {
    const searchPromise = searchStores(node.query, city);
    const timeoutPromise = new Promise<never>((_, reject) =>
      setTimeout(() => reject(new Error('SSR timeout')), 4000)
    );
    const outcomes = (await Promise.race([searchPromise, timeoutPromise])) as any;
    report = buildReport(node.query, outcomes);
  } catch {
    // Si da timeout o error en SSR, no bloqueamos la renderización:
    // El cliente hidratará automáticamente en tiempo real con /api/buscar
  }
}

const verdict  = report?.verdict ?? null;
const rawOffers: any[] = report?.offers ?? [];

// ORDENADO POR PRECIO (MENOR A MAYOR) POR DEFECTO
const sortedOffers = [...rawOffers].sort((a, b) => (a.price || 0) - (b.price || 0));
const topOffers = sortedOffers.slice(0, 200);

// Detección de marca auxiliar
function detectBrand(name: string): string {
  const n = (name || '').toLowerCase();
  if (n.includes('iphone') || n.includes('apple')) return 'Apple';
  if (n.includes('samsung') || n.includes('galaxy')) return 'Samsung';
  if (n.includes('xiaomi') || n.includes('redmi') || n.includes('poco')) return 'Xiaomi';
  if (n.includes('motorola') || n.includes('moto ')) return 'Motorola';
  if (n.includes('honor')) return 'Honor';
  if (n.includes('huawei')) return 'Huawei';
  if (n.includes('oppo')) return 'Oppo';
  if (n.includes('realme')) return 'Realme';
  if (n.includes('infinix')) return 'Infinix';
  if (n.includes('tecno')) return 'Tecno';
  if (n.includes('lg')) return 'LG';
  if (n.includes('sony')) return 'Sony';
  if (n.includes('hp')) return 'HP';
  if (n.includes('lenovo')) return 'Lenovo';
  if (n.includes('asus')) return 'Asus';
  return 'Otras marcas';
}

// Estadísticas para los filtros de la izquierda
const storeCounts: Record<string, number> = {};
const brandCounts: Record<string, number> = {};
let minPrice = Infinity;
let maxPrice = 0;

topOffers.forEach((o) => {
  storeCounts[o.store_name] = (storeCounts[o.store_name] || 0) + 1;
  const brand = detectBrand(o.name);
  brandCounts[brand] = (brandCounts[brand] || 0) + 1;
  if (o.price < minPrice) minPrice = o.price;
  if (o.price > maxPrice) maxPrice = o.price;
});

const storeNames = Object.keys(storeCounts).sort();
const brandNames = Object.keys(brandCounts).sort((a, b) => brandCounts[b] - brandCounts[a]);

// Breadcrumb items
const crumbData = collNode
  ? getCollectionBreadcrumbItems(collNode, BASE).map((c) => ({ name: c.name, item: c.url }))
  : getBreadcrumb(segments, BASE);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbData.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
};

// ItemList schema para Google
const itemListSchema = topOffers.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: node.nombre,
  description: node.metaDesc,
  numberOfItems: topOffers.length,
  itemListElement: topOffers.map((o, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Product',
      name: o.name,
      ...(o.image ? { image: o.image } : {}),
      offers: {
        '@type': 'Offer',
        price: o.price.toFixed(0),
        priceCurrency: 'COP',
        seller: { '@type': 'Organization', name: o.store_name },
        url: o.url,
        availability: 'https://schema.org/InStock',
      },
    },
  })),
} : null;

// Huincha dinámica fluida con navegación por niveles
const huinchaNav = collNode ? getHuinchaNavigation(collNode) : null;
const isCelularesCat = taxPath.startsWith('tecnologia/celulares');

let huinchaItems: HuinchaItem[] = [];

if (huinchaNav && huinchaNav.items.length > 0) {
  huinchaItems = huinchaNav.items;
} else if (isCelularesCat) {
  huinchaItems = [
    {
      id: 'apple',
      name: 'Apple iPhone',
      url: '/categoria/tecnologia/celulares/apple',
      countStr: '142 refs',
      iconType: 'apple',
      isActive: taxPath === 'tecnologia/celulares/apple',
    },
    {
      id: 'samsung',
      name: 'Samsung Galaxy',
      url: '/categoria/tecnologia/celulares/samsung',
      countStr: '198 refs',
      iconType: 'samsung',
      isActive: taxPath === 'tecnologia/celulares/samsung',
    },
    {
      id: 'xiaomi',
      name: 'Xiaomi Redmi',
      url: '/categoria/tecnologia/celulares/xiaomi',
      countStr: '156 refs',
      iconType: 'xiaomi',
      isActive: taxPath === 'tecnologia/celulares/xiaomi',
    },
    {
      id: 'motorola',
      name: 'Motorola Moto',
      url: '/categoria/tecnologia/celulares/motorola',
      countStr: '118 refs',
      iconType: 'motorola',
      isActive: taxPath === 'tecnologia/celulares/motorola',
    },
    {
      id: 'honor',
      name: 'Honor',
      url: '/categoria/tecnologia/celulares/honor',
      countStr: '86 refs',
      iconType: 'honor',
      isActive: taxPath === 'tecnologia/celulares/honor',
    },
    {
      id: 'smartwatches',
      name: 'Smartwatches',
      url: '/categoria/tecnologia/celulares/smartwatches',
      countStr: '64 refs',
      iconType: 'smartwatch',
      isActive: taxPath === 'tecnologia/celulares/smartwatches',
    },
    {
      id: 'audifonos',
      name: 'Audífonos',
      url: '/categoria/tecnologia/celulares/audifonos',
      countStr: '92 refs',
      iconType: 'audifonos',
      isActive: taxPath === 'tecnologia/celulares/audifonos',
    },
    {
      id: 'accesorios',
      name: 'Accesorios',
      url: '/categoria/tecnologia/celulares/accesorios',
      countStr: '75 refs',
      iconType: 'accesorios',
      isActive: taxPath === 'tecnologia/celulares/accesorios',
    },
  ];
} else if (children.length > 0) {
  huinchaItems = children.map(({ path, node: child }, idx) => ({
    id: path,
    name: child.nombre,
    url: `/categoria/${path}`,
    countStr: `${30 + (idx * 17) % 180} refs`,
    emoji: '🏷️',
    isActive: taxPath === path,
  }));
}
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{node.titleSeo}</title>
    <meta name="description" content={node.metaDesc} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={node.titleSeo} />
    <meta property="og:description" content={verdict
      ? `${verdict.headline} · ${cop(verdict.price)} en ${verdict.store_name}`
      : node.metaDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {verdict?.image && <meta property="og:image" content={verdict.image} />}
    <meta name="theme-color" content="#0e6a45" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  </head>
  <body>
    <Nav />

    <main class="cat-page-container" id="cat-page-container" data-query={node.query || ''} data-city={city.id} data-initial-count={topOffers.length}>
      {/* ── Miga de pan (Breadcrumb) ─────────────────────────────────── */}
      <nav class="breadcrumb-nav" aria-label="Navegación de miga de pan">
        <ol class="breadcrumb-list">
          {crumbData.map((c, i) => (
            <li class="breadcrumb-item">
              {i > 0 && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
              {i < crumbData.length - 1 ? (
                <a href={c.item.replace(BASE, '')} class="breadcrumb-link">{c.name}</a>
              ) : (
                <span class="breadcrumb-current" aria-current="page">{c.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>

      {/* ── Huincha Arriba (Carrusel de Subcategorías y Marcas) ────────── */}
      {huinchaItems.length > 0 && (
        <CategoryHuincha
          kicker={huinchaNav?.kicker || (isCelularesCat ? 'LÍNEAS Y MARCAS OFICIALES DE CELULARES' : `SUBCATEGORÍAS DE ${node.nombre.toUpperCase()}`)}
          subtitle={huinchaNav?.subtitle || (isCelularesCat ? 'Navegue entre nuestras familias de telefonía oficial con envíos a toda Colombia y precios en tiempo real' : 'Navegue entre nuestras subcategorías con precios actualizados')}
          items={huinchaItems}
        />
      )}

      {errorMsg && <div class="error-banner" role="alert">{errorMsg}</div>}

      {/* ── Botón móvil para abrir filtros ──────────────────────────── */}
      <div class="mobile-filter-trigger-bar">
        <button type="button" class="btn-mobile-filters" id="btn-open-mobile-filters">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          <span>Filtros y Ordenación</span>
        </button>
      </div>

      {/* ── CONTENEDOR PRINCIPAL: TÍTULO + VEREDICTO + FILTROS (IZQUIERDA) Y GRILLA AL LADO (DERECHA) ── */}
      <div class="cat-layout-wrapper">
        {/* ── COLUMNA IZQUIERDA: TÍTULO, VEREDICTO Y FILTROS ──────────── */}
        <aside class="cat-sidebar-col" id="cat-sidebar" aria-label="Filtros e información de catálogo">
          {/* 1. TÍTULO DE LA CATEGORÍA */}
          <div class="sidebar-cat-header">
            <div class="cat-header-kicker">
              <span class="cat-badge-dot"></span>
              <span>CATÁLOGO ESPECIALIZADO</span>
            </div>
            <h1 class="cat-sidebar-title">{node.h1 || `${node.nombre} en Colombia`}</h1>
            <p class="cat-sidebar-meta">
              <strong>Resultados (<span id="sidebar-count-number">{topOffers.length}</span> ofertas)</strong>
            </p>
          </div>

          {/* 2. VEREDICTO COMPACTO SOBRE LOS FILTROS */}
          <div id="sidebar-verdict-slot">
            {verdict && (
              <div class="sidebar-verdict-card" aria-label="Menor precio detectado en Colombia">
                <div class="verdict-pill-header">
                  <span class="verdict-trophy">🏆</span>
                  <span class="verdict-tag">MENOR PRECIO HOY</span>
                </div>

                <div class="sidebar-verdict-body">
                  {verdict.image && (
                    <div class="sidebar-verdict-img-wrap">
                      <img src={verdict.image} alt={verdict.name} class="sidebar-verdict-img" width="68" height="68" loading="eager" />
                    </div>
                  )}
                  <div class="sidebar-verdict-details">
                    <h2 class="sidebar-verdict-name" title={verdict.name}>{verdict.headline}</h2>
                    <div class="sidebar-verdict-pricing">
                      <strong class="sidebar-verdict-price">{cop(verdict.price)}</strong>
                      <span class="sidebar-verdict-store">en {verdict.store_name}</span>
                    </div>
                    {verdict.payment_note && (
                      <span class="sidebar-verdict-payment">💳 {verdict.payment_note}</span>
                    )}
                  </div>
                </div>

                <div class="sidebar-verdict-actions">
                  <a href={verdict.url} target="_blank" rel="noopener noreferrer" class="btn-verdict-buy">
                    Ver en {verdict.store_name} →
                  </a>
                  <button
                    type="button"
                    class="btn-verdict-add"
                    data-name={verdict.name}
                    data-store={verdict.store_name}
                    data-price={verdict.price}
                    data-image={verdict.image ?? ''}
                  >
                    ➕ Agregar a lista
                  </button>
                </div>
              </div>
            )}
          </div>

          {/* 3. FILTROS TÉCNICOS / COMERCIALES */}
          <div class="sidebar-filters-box">
            <div class="sidebar-header">
              <div class="sidebar-title-group">
                <span class="sidebar-icon">🎚️</span>
                <h2 class="sidebar-title">Filtros Técnicos</h2>
              </div>
              <button type="button" class="btn-clear-all-filters" id="btn-clear-filters" title="Limpiar todos los filtros">
                Limpiar
              </button>
              <button type="button" class="btn-close-mobile-filters" id="btn-close-mobile-filters" aria-label="Cerrar filtros">
                ✕
              </button>
            </div>

            <div class="sidebar-filters-body">
              {/* Filtro: Tienda */}
              <div id="sidebar-stores-slot">
                {storeNames.length > 0 && (
                  <details class="filter-group" open>
                    <summary class="filter-group-title">
                      <span>Tiendas ({storeNames.length})</span>
                      <span class="filter-chevron">▾</span>
                    </summary>
                    <div class="filter-group-content">
                      {storeNames.map((sName) => (
                        <label class="filter-checkbox-label">
                          <input
                            type="checkbox"
                            class="filter-checkbox filter-store-check"
                            value={sName}
                          />
                          <span class="filter-text">{sName}</span>
                          <span class="filter-count">({storeCounts[sName]})</span>
                        </label>
                      ))}
                    </div>
                  </details>
                )}
              </div>

              {/* Filtro: Marcas */}
              <div id="sidebar-brands-slot">
                {brandNames.length > 0 && (
                  <details class="filter-group" open>
                    <summary class="filter-group-title">
                      <span>Marcas ({brandNames.length})</span>
                      <span class="filter-chevron">▾</span>
                    </summary>
                    <div class="filter-group-content">
                      {brandNames.map((bName) => (
                        <label class="filter-checkbox-label">
                          <input
                            type="checkbox"
                            class="filter-checkbox filter-brand-check"
                            value={bName}
                          />
                          <span class="filter-text">{bName}</span>
                          <span class="filter-count">({brandCounts[bName]})</span>
                        </label>
                      ))}
                    </div>
                  </details>
                )}
              </div>

              {/* Filtro: Rango de Precio */}
              <details class="filter-group" open>
                <summary class="filter-group-title">
                  <span>Rango de Precio</span>
                  <span class="filter-chevron">▾</span>
                </summary>
                <div class="filter-group-content">
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="all" checked />
                    <span class="filter-text">Todos los precios</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="under-500k" />
                    <span class="filter-text">Hasta $500.000</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="500k-1500k" />
                    <span class="filter-text">$500.000 a $1.500.000</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="1500k-3000k" />
                    <span class="filter-text">$1.500.000 a $3.000.000</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="over-3000k" />
                    <span class="filter-text">Más de $3.000.000</span>
                  </label>
                </div>
              </details>

              {/* Filtro: Descuento / Ofertas */}
              <details class="filter-group" open>
                <summary class="filter-group-title">
                  <span>Descuento</span>
                  <span class="filter-chevron">▾</span>
                </summary>
                <div class="filter-group-content">
                  <label class="filter-checkbox-label">
                    <input type="checkbox" class="filter-checkbox" id="check-only-discounts" />
                    <span class="filter-text">Solo productos con descuento</span>
                  </label>
                </div>
              </details>
            </div>
          </div>
        </aside>

        {/* ── COLUMNA DERECHA: GRILLA DE PRODUCTOS AL LADO DE LOS FILTROS ── */}
        <section class="cat-content-col" aria-label="Resultados de productos ordenados por precio">
          {/* Barra superior de resultados y selector de orden */}
          <div class="cat-control-bar">
            <div class="control-bar-left">
              <span class="results-badge" id="results-count-badge">
                <strong id="visible-count-number">{topOffers.length}</strong> piezas encontradas
              </span>
              <span class="page-subtitle-muted">Despacho express y envíos nacionales</span>
              <div class="active-chips-container" id="active-chips-container">
                <!-- Chips activos inyectados por JS -->
              </div>
            </div>

            <div class="control-bar-right">
              <label for="cat-city-select" class="sort-label">📍 Ciudad:</label>
              <select id="cat-city-select" class="sort-select">
                <option value="bogota" selected={city.id === 'bogota'}>Bogotá</option>
                <option value="medellin" selected={city.id === 'medellin'}>Medellín</option>
                <option value="cali" selected={city.id === 'cali'}>Cali</option>
                <option value="barranquilla" selected={city.id === 'barranquilla'}>Barranquilla</option>
                <option value="cartagena" selected={city.id === 'cartagena'}>Cartagena</option>
                <option value="bucaramanga" selected={city.id === 'bucaramanga'}>Bucaramanga</option>
                <option value="pereira" selected={city.id === 'pereira'}>Pereira</option>
                <option value="manizales" selected={city.id === 'manizales'}>Manizales</option>
                <option value="cucuta" selected={city.id === 'cucuta'}>Cúcuta</option>
                <option value="ibague" selected={city.id === 'ibague'}>Ibagué</option>
                <option value="santa-marta" selected={city.id === 'santa-marta'}>Santa Marta</option>
                <option value="villavicencio" selected={city.id === 'villavicencio'}>Villavicencio</option>
              </select>

              <label for="sort-select" class="sort-label">Ordenar:</label>
              <select id="sort-select" class="sort-select">
                <option value="price-asc" selected>Precio: Menor a Mayor (Recomendado)</option>
                <option value="price-desc">Precio: Mayor a Menor</option>
                <option value="discount-desc">Mayor Descuento %</option>
                <option value="name-asc">Nombre: A - Z</option>
              </select>

              <button type="button" class="btn-refresh-prices" id="btn-refresh-prices" title="Actualizar precios en tiempo real" aria-label="Actualizar precios en tiempo real">
                🔄
              </button>
            </div>
          </div>

          {/* Loader animado en tiempo real */}
          <div class="cat-live-loader" id="cat-live-loader" style={topOffers.length > 0 ? "display: none;" : "display: block;"}>
            <div class="cat-live-loader-card">
              <div class="cat-live-spinner"></div>
              <div class="cat-live-loader-text">
                <h3 class="cat-live-loading-title">Consultando precios en tiempo real…</h3>
                <p class="cat-live-loading-subtitle">Buscando "{node.query}" en Éxito, Carulla, Jumbo, Olímpica, D1, Alkosto y Falabella</p>
              </div>
            </div>
            <div class="cat-skeleton-grid">
              <div class="cat-skeleton-card"></div>
              <div class="cat-skeleton-card"></div>
              <div class="cat-skeleton-card"></div>
              <div class="cat-skeleton-card"></div>
              <div class="cat-skeleton-card"></div>
              <div class="cat-skeleton-card"></div>
            </div>
          </div>

          {/* Grilla de Productos */}
          <div class="product-cards-grid" id="product-cards-grid" role="list" style={topOffers.length === 0 ? "display: none;" : "display: grid;"}>
            {topOffers.map((o, idx) => {
              const hasDiscount = o.list_price && o.list_price > o.price;
              const discountPct = hasDiscount ? Math.round(((o.list_price - o.price) / o.list_price) * 100) : 0;
              const brand = detectBrand(o.name);
              const isWinner = idx === 0;

              return (
                <article
                  class="cat-product-card"
                  data-store={o.store_name}
                  data-brand={brand}
                  data-price={o.price}
                  data-discount={discountPct}
                  data-name={o.name}
                  role="listitem"
                >
                  <div class="card-top-badges">
                    <span class={`store-pill store-pill--${o.store_name.toLowerCase().replace(/[^a-z0-9]/g, '')}`}>
                      {o.store_name}
                    </span>
                    {hasDiscount && discountPct > 0 && (
                      <span class="discount-pill">-{discountPct}%</span>
                    )}
                    {isWinner && (
                      <span class="winner-mini-badge">★ Menor precio</span>
                    )}
                  </div>

                  <div class="card-thumb-wrap">
                    {o.image ? (
                      <img src={o.image} alt={o.name} class="card-thumb" width="140" height="140" loading="lazy" />
                    ) : (
                      <div class="card-thumb-fallback">📱</div>
                    )}
                  </div>

                  <div class="card-content">
                    <h3 class="card-title" title={o.name}>{o.name}</h3>
                    {o.unit_price && (
                      <div class="card-unit-price">{cop(o.unit_price)} / {o.unit_label}</div>
                    )}

                    <div class="card-pricing">
                      <span class="card-current-price">{cop(o.price)}</span>
                      {hasDiscount && (
                        <span class="card-old-price">{cop(o.list_price)}</span>
                      )}
                    </div>
                  </div>

                  <div class="card-actions">
                    <a href={o.url} target="_blank" rel="noopener noreferrer" class="btn-card-buy">
                      Ver en {o.store_name} →
                    </a>
                    <button
                      type="button"
                      class="btn-card-add"
                      data-name={o.name}
                      data-store={o.store_name}
                      data-price={o.price}
                      data-image={o.image ?? ''}
                      title="Añadir a mi lista de compras activa"
                    >
                      ➕
                    </button>
                  </div>
                </article>
              );
            })}
          </div>

          <nav class="offers-pager" id="product-pager" aria-label="Páginas de productos" hidden></nav>

          {/* Estado de sin resultados */}
          <div class="no-filter-results" id="no-filter-results" style="display: none;">
            <div class="no-results-icon">🔎</div>
            <h3>No encontramos resultados con los filtros actuales</h3>
            <p>Intenta desmarcar algunos filtros o restablecer la búsqueda.</p>
            <button type="button" class="btn-reset-filters-cta" id="btn-reset-filters-cta">
              Restablecer filtros
            </button>
          </div>
        </section>
      </div>

      {/* ── Huincha Inferior (SEO y FAQ con Schema FAQPage) ───────────── */}
      <CategorySeoFaq
        categoryName={node.nombre}
        isTechCategory={catId === 'tecnologia'}
      />
    </main>

    <AddToListModal />

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Mercado Lista · Comparador de precios en tiempo real para Colombia</p>
    </footer>

    {/* Scripts interactivos para hidratación en tiempo real, filtros laterales, ordenación instantánea y modal de listas */}
    <script>
      import { openCatAddModal } from '../../scripts/catAddToList';
      import { escapeHtml } from '../../lib/normalize';

      // Contenedor principal con metadatos
      const pageContainer = document.getElementById('cat-page-container');
      const query = pageContainer?.dataset.query || '';
      let currentCity = pageContainer?.dataset.city || 'bogota';
      const initialCount = Number(pageContainer?.dataset.initialCount || 0);
      // Grilla: 4 columnas × 5 filas = 20 productos por página
      const PLP_PAGE_SIZE = 20;
      let currentPage = 1;
      let lastFilterKey = '';

      // Elementos del DOM
      const sidebar = document.getElementById('cat-sidebar');
      const grid = document.getElementById('product-cards-grid');
      const pager = document.getElementById('product-pager');
      const liveLoader = document.getElementById('cat-live-loader');
      const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
      const citySelect = document.getElementById('cat-city-select') as HTMLSelectElement | null;
      const refreshBtn = document.getElementById('btn-refresh-prices');
      const visibleCountEl = document.getElementById('visible-count-number');
      const sidebarCountEl = document.getElementById('sidebar-count-number');
      const activeChipsEl = document.getElementById('active-chips-container');
      const clearBtn = document.getElementById('btn-clear-filters');
      const noResultsBox = document.getElementById('no-filter-results');
      const resetCtaBtn = document.getElementById('btn-reset-filters-cta');
      const verdictSlot = document.getElementById('sidebar-verdict-slot');
      const storesSlot = document.getElementById('sidebar-stores-slot');
      const brandsSlot = document.getElementById('sidebar-brands-slot');

      // Móvil
      const openMobileBtn = document.getElementById('btn-open-mobile-filters');
      const closeMobileBtn = document.getElementById('btn-close-mobile-filters');

      if (openMobileBtn && sidebar) {
        openMobileBtn.addEventListener('click', () => {
          sidebar.classList.add('cat-sidebar--mobile-open');
        });
      }

      if (closeMobileBtn && sidebar) {
        closeMobileBtn.addEventListener('click', () => {
          sidebar.classList.remove('cat-sidebar--mobile-open');
        });
      }

      // Modal para agregar a lista
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('.btn-verdict-add, .btn-card-add');
        if (!btn) return;
        e.preventDefault();
        openCatAddModal({
          name:       btn.dataset.name  ?? '',
          store_name: btn.dataset.store ?? '',
          price:      btn.dataset.price ? Number(btn.dataset.price) : undefined,
          image:      btn.dataset.image || undefined,
        });
      });

      function detectBrand(name: string): string {
        const n = (name || '').toLowerCase();
        if (n.includes('iphone') || n.includes('apple')) return 'Apple';
        if (n.includes('samsung') || n.includes('galaxy')) return 'Samsung';
        if (n.includes('xiaomi') || n.includes('redmi') || n.includes('poco')) return 'Xiaomi';
        if (n.includes('motorola') || n.includes('moto ')) return 'Motorola';
        if (n.includes('honor')) return 'Honor';
        if (n.includes('huawei')) return 'Huawei';
        if (n.includes('oppo')) return 'Oppo';
        if (n.includes('realme')) return 'Realme';
        if (n.includes('infinix')) return 'Infinix';
        if (n.includes('tecno')) return 'Tecno';
        if (n.includes('lg')) return 'LG';
        if (n.includes('sony')) return 'Sony';
        if (n.includes('hp')) return 'HP';
        if (n.includes('lenovo')) return 'Lenovo';
        if (n.includes('asus')) return 'Asus';
        return 'Otras marcas';
      }

      function formatCop(val: number): string {
        return '$ ' + Math.round(val).toLocaleString('es-CO');
      }

      function renderOffers(report: any) {
        if (!grid) return;
        const rawOffers = report.offers || [];
        const sorted = [...rawOffers].sort((a: any, b: any) => (a.price || 0) - (b.price || 0));
        const topOffers = sorted.slice(0, 200);

        // Actualizar contadores
        if (visibleCountEl) visibleCountEl.textContent = String(topOffers.length);
        if (sidebarCountEl) sidebarCountEl.textContent = String(topOffers.length);

        if (topOffers.length === 0) {
          if (liveLoader) liveLoader.style.display = 'none';
          if (grid) grid.style.display = 'none';
          if (noResultsBox) noResultsBox.style.display = 'block';
          return;
        }

        // Renderizar veredicto ganador
        if (verdictSlot) {
          const v = report.verdict;
          if (v) {
            verdictSlot.innerHTML = `
              <div class="sidebar-verdict-card" aria-label="Menor precio detectado en Colombia">
                <div class="verdict-pill-header">
                  <span class="verdict-trophy">🏆</span>
                  <span class="verdict-tag">MENOR PRECIO HOY</span>
                </div>
                <div class="sidebar-verdict-body">
                  ${v.image ? `
                    <div class="sidebar-verdict-img-wrap">
                      <img src="${escapeHtml(v.image)}" alt="${escapeHtml(v.name)}" class="sidebar-verdict-img" width="68" height="68" loading="eager" />
                    </div>` : ''}
                  <div class="sidebar-verdict-details">
                    <h2 class="sidebar-verdict-name" title="${escapeHtml(v.name)}">${escapeHtml(v.headline || v.name)}</h2>
                    <div class="sidebar-verdict-pricing">
                      <strong class="sidebar-verdict-price">${formatCop(v.price)}</strong>
                      <span class="sidebar-verdict-store">en ${escapeHtml(v.store_name)}</span>
                    </div>
                    ${v.payment_note ? `<span class="sidebar-verdict-payment">💳 ${escapeHtml(v.payment_note)}</span>` : ''}
                  </div>
                </div>
                <div class="sidebar-verdict-actions">
                  <a href="${escapeHtml(v.url)}" target="_blank" rel="noopener noreferrer" class="btn-verdict-buy">
                    Ver en ${escapeHtml(v.store_name)} →
                  </a>
                  <button
                    type="button"
                    class="btn-verdict-add"
                    data-name="${escapeHtml(v.name)}"
                    data-store="${escapeHtml(v.store_name)}"
                    data-price="${v.price}"
                    data-image="${escapeHtml(v.image || '')}"
                  >
                    ➕ Agregar a lista
                  </button>
                </div>
              </div>
            `;
          } else {
            verdictSlot.innerHTML = '';
          }
        }

        // Conteo para filtros laterales
        const storeCounts: Record<string, number> = {};
        const brandCounts: Record<string, number> = {};
        topOffers.forEach((o: any) => {
          storeCounts[o.store_name] = (storeCounts[o.store_name] || 0) + 1;
          const brand = detectBrand(o.name);
          brandCounts[brand] = (brandCounts[brand] || 0) + 1;
        });

        // Reconstruir filtro de tiendas
        if (storesSlot) {
          const sNames = Object.keys(storeCounts).sort();
          if (sNames.length > 0) {
            storesSlot.innerHTML = `
              <details class="filter-group" open>
                <summary class="filter-group-title">
                  <span>Tiendas (${sNames.length})</span>
                  <span class="filter-chevron">▾</span>
                </summary>
                <div class="filter-group-content">
                  ${sNames.map((sName) => `
                    <label class="filter-checkbox-label">
                      <input type="checkbox" class="filter-checkbox filter-store-check" value="${escapeHtml(sName)}" />
                      <span class="filter-text">${escapeHtml(sName)}</span>
                      <span class="filter-count">(${storeCounts[sName]})</span>
                    </label>
                  `).join('')}
                </div>
              </details>
            `;
          } else {
            storesSlot.innerHTML = '';
          }
        }

        // Reconstruir filtro de marcas
        if (brandsSlot) {
          const bNames = Object.keys(brandCounts).sort((a, b) => brandCounts[b] - brandCounts[a]);
          if (bNames.length > 0) {
            brandsSlot.innerHTML = `
              <details class="filter-group" open>
                <summary class="filter-group-title">
                  <span>Marcas (${bNames.length})</span>
                  <span class="filter-chevron">▾</span>
                </summary>
                <div class="filter-group-content">
                  ${bNames.map((bName) => `
                    <label class="filter-checkbox-label">
                      <input type="checkbox" class="filter-checkbox filter-brand-check" value="${escapeHtml(bName)}" />
                      <span class="filter-text">${escapeHtml(bName)}</span>
                      <span class="filter-count">(${brandCounts[bName]})</span>
                    </label>
                  `).join('')}
                </div>
              </details>
            `;
          } else {
            brandsSlot.innerHTML = '';
          }
        }

        // Renderizar tarjetas de productos
        grid.innerHTML = topOffers.map((o: any, idx: number) => {
          const hasDiscount = o.list_price && o.list_price > o.price;
          const discountPct = hasDiscount ? Math.round(((o.list_price - o.price) / o.list_price) * 100) : 0;
          const brand = detectBrand(o.name);
          const isWinner = idx === 0;
          const storePillClass = `store-pill store-pill--${o.store_name.toLowerCase().replace(/[^a-z0-9]/g, '')}`;

          return `
            <article
              class="cat-product-card"
              data-store="${escapeHtml(o.store_name)}"
              data-brand="${escapeHtml(brand)}"
              data-price="${o.price}"
              data-discount="${discountPct}"
              data-name="${escapeHtml(o.name)}"
              role="listitem"
            >
              <div class="card-top-badges">
                <span class="${storePillClass}">${escapeHtml(o.store_name)}</span>
                ${hasDiscount && discountPct > 0 ? `<span class="discount-pill">-${discountPct}%</span>` : ''}
                ${isWinner ? `<span class="winner-mini-badge">★ Menor precio</span>` : ''}
              </div>

              <div class="card-thumb-wrap">
                ${o.image ? `
                  <img src="${escapeHtml(o.image)}" alt="${escapeHtml(o.name)}" class="card-thumb" width="140" height="140" loading="lazy" />
                ` : `
                  <div class="card-thumb-fallback">📱</div>
                `}
              </div>

              <div class="card-content">
                <h3 class="card-title" title="${escapeHtml(o.name)}">${escapeHtml(o.name)}</h3>
                ${o.unit_price ? `
                  <div class="card-unit-price">${formatCop(o.unit_price)} / ${escapeHtml(o.unit_label || '')}</div>
                ` : ''}

                <div class="card-pricing">
                  <span class="card-current-price">${formatCop(o.price)}</span>
                  ${hasDiscount ? `<span class="card-old-price">${formatCop(o.list_price)}</span>` : ''}
                </div>
              </div>

              <div class="card-actions">
                <a href="${escapeHtml(o.url)}" target="_blank" rel="noopener noreferrer" class="btn-card-buy">
                  Ver en ${escapeHtml(o.store_name)} →
                </a>
                <button
                  type="button"
                  class="btn-card-add"
                  data-name="${escapeHtml(o.name)}"
                  data-store="${escapeHtml(o.store_name)}"
                  data-price="${o.price}"
                  data-image="${escapeHtml(o.image || '')}"
                  title="Añadir a mi lista de compras activa"
                >
                  ➕
                </button>
              </div>
            </article>
          `;
        }).join('');

        if (liveLoader) liveLoader.style.display = 'none';
        if (noResultsBox) noResultsBox.style.display = 'none';
        grid.style.display = 'grid';
        currentPage = 1;

        applyFiltersAndSort();
      }

      async function fetchLiveCategoryOffers(q: string, c: string) {
        if (!q) return;
        if (liveLoader) liveLoader.style.display = 'block';
        if (grid) grid.style.display = 'none';
        if (noResultsBox) noResultsBox.style.display = 'none';

        try {
          const res = await fetch(`/api/buscar?q=${encodeURIComponent(q)}&ciudad=${encodeURIComponent(c)}`);
          if (!res.ok) throw new Error('Error al consultar precios en vivo');
          const report = await res.json();
          renderOffers(report);
        } catch (err) {
          console.warn('Error fetching live offers:', err);
          if (liveLoader) liveLoader.style.display = 'none';
          if (noResultsBox) noResultsBox.style.display = 'block';
        }
      }

      function renderPlpPager(pages: number, total: number) {
        if (!pager) return;
        pager.replaceChildren();
        pager.hidden = pages <= 1;
        if (pages <= 1) return;

        const goTo = (target: number) => {
          currentPage = target;
          applyFiltersAndSort();
          grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        const prev = document.createElement('button');
        prev.type = 'button';
        prev.className = 'btn-page';
        prev.textContent = '← Anterior';
        prev.disabled = currentPage === 1;
        prev.addEventListener('click', () => goTo(currentPage - 1));

        const info = document.createElement('span');
        info.className = 'pager-info';
        info.textContent = `Página ${currentPage} de ${pages} · ${total} productos`;

        const next = document.createElement('button');
        next.type = 'button';
        next.className = 'btn-page';
        next.textContent = 'Siguiente →';
        next.disabled = currentPage === pages;
        next.addEventListener('click', () => goTo(currentPage + 1));

        pager.append(prev, info, next);
      }

      function applyFiltersAndSort() {
        if (!grid) return;
        const cards = Array.from(grid.querySelectorAll<HTMLElement>('.cat-product-card'));
        if (cards.length === 0) return;

        // 1. Tiendas seleccionadas
        const selectedStores = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-store-check:checked')).map(c => c.value);

        // 2. Marcas seleccionadas
        const selectedBrands = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-brand-check:checked')).map(c => c.value);

        // 3. Rango de precio
        const priceRadio = document.querySelector<HTMLInputElement>('.filter-price-radio:checked');
        const priceVal = priceRadio ? priceRadio.value : 'all';

        // 4. Solo con descuento
        const discountCheck = document.getElementById('check-only-discounts') as HTMLInputElement | null;
        const onlyDiscounts = discountCheck ? discountCheck.checked : false;

        let visibleCount = 0;

        cards.forEach((card) => {
          const store = card.dataset.store || '';
          const brand = card.dataset.brand || '';
          const price = Number(card.dataset.price || 0);
          const discount = Number(card.dataset.discount || 0);

          let match = true;

          // Tienda
          if (selectedStores.length > 0 && !selectedStores.includes(store)) {
            match = false;
          }

          // Marca
          if (match && selectedBrands.length > 0 && !selectedBrands.includes(brand)) {
            match = false;
          }

          // Rango de precio
          if (match && priceVal !== 'all') {
            if (priceVal === 'under-500k' && price > 500000) match = false;
            else if (priceVal === '500k-1500k' && (price < 500000 || price > 1500000)) match = false;
            else if (priceVal === '1500k-3000k' && (price < 1500000 || price > 3000000)) match = false;
            else if (priceVal === 'over-3000k' && price < 3000000) match = false;
          }

          // Descuento
          if (match && onlyDiscounts && discount <= 0) {
            match = false;
          }

          if (match) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // 5. Ordenación
        const sortVal = sortSelect ? sortSelect.value : 'price-asc';
        cards.sort((a, b) => {
          const priceA = Number(a.dataset.price || 0);
          const priceB = Number(b.dataset.price || 0);
          const discA = Number(a.dataset.discount || 0);
          const discB = Number(b.dataset.discount || 0);
          const nameA = (a.dataset.name || '').toLowerCase();
          const nameB = (b.dataset.name || '').toLowerCase();

          if (sortVal === 'price-asc') return priceA - priceB;
          if (sortVal === 'price-desc') return priceB - priceA;
          if (sortVal === 'discount-desc') return discB - discA;
          if (sortVal === 'name-asc') return nameA.localeCompare(nameB);
          return 0;
        });

        cards.forEach((card) => grid.appendChild(card));

        // 5b. Paginación sobre las tarjetas que pasaron los filtros
        const matched = cards.filter((card) => card.style.display !== 'none');
        const pages = Math.max(1, Math.ceil(matched.length / PLP_PAGE_SIZE));
        const filterKey = [selectedStores.join('|'), selectedBrands.join('|'), priceVal, String(onlyDiscounts), sortVal].join('#');
        if (filterKey !== lastFilterKey) {
          currentPage = 1;
          lastFilterKey = filterKey;
        }
        currentPage = Math.min(currentPage, pages);
        matched.forEach((card, index) => {
          const inPage = index >= (currentPage - 1) * PLP_PAGE_SIZE && index < currentPage * PLP_PAGE_SIZE;
          card.style.display = inPage ? 'flex' : 'none';
        });
        renderPlpPager(pages, matched.length);

        // 7. Actualizar contador
        if (visibleCountEl) visibleCountEl.textContent = String(visibleCount);

        // 7. Mostrar estado de sin resultados si aplica
        if (noResultsBox) {
          noResultsBox.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        // 8. Renderizar chips activos
        renderActiveChips(selectedStores, selectedBrands, priceVal, onlyDiscounts);
      }

      function renderActiveChips(stores: string[], brands: string[], priceVal: string, onlyDiscounts: boolean) {
        if (!activeChipsEl) return;
        activeChipsEl.innerHTML = '';

        const hasAnyFilter = stores.length > 0 || brands.length > 0 || priceVal !== 'all' || onlyDiscounts;

        stores.forEach((s) => {
          const chip = document.createElement('span');
          chip.className = 'active-filter-chip';
          chip.innerHTML = `<span>Tienda: ${escapeHtml(s)}</span><button type="button" data-type="store" data-val="${escapeHtml(s)}">✕</button>`;
          activeChipsEl.appendChild(chip);
        });

        brands.forEach((b) => {
          const chip = document.createElement('span');
          chip.className = 'active-filter-chip';
          chip.innerHTML = `<span>Marca: ${escapeHtml(b)}</span><button type="button" data-type="brand" data-val="${escapeHtml(b)}">✕</button>`;
          activeChipsEl.appendChild(chip);
        });

        if (priceVal !== 'all') {
          const labels: Record<string, string> = {
            'under-500k': '< $500K',
            '500k-1500k': '$500K - $1.5M',
            '1500k-3000k': '$1.5M - $3M',
            'over-3000k': '> $3M',
          };
          const chip = document.createElement('span');
          chip.className = 'active-filter-chip';
          chip.innerHTML = `<span>Precio: ${labels[priceVal] || priceVal}</span><button type="button" data-type="price">✕</button>`;
          activeChipsEl.appendChild(chip);
        }

        if (onlyDiscounts) {
          const chip = document.createElement('span');
          chip.className = 'active-filter-chip';
          chip.innerHTML = `<span>Solo ofertas</span><button type="button" data-type="discount">✕</button>`;
          activeChipsEl.appendChild(chip);
        }

        if (hasAnyFilter) {
          const resetAll = document.createElement('button');
          resetAll.type = 'button';
          resetAll.className = 'btn-reset-chips';
          resetAll.textContent = 'Restablecer';
          resetAll.addEventListener('click', resetAllFilters);
          activeChipsEl.appendChild(resetAll);
        }
      }

      function resetAllFilters() {
        document.querySelectorAll<HTMLInputElement>('.filter-store-check').forEach(c => c.checked = false);
        document.querySelectorAll<HTMLInputElement>('.filter-brand-check').forEach(c => c.checked = false);
        const allRadio = document.querySelector<HTMLInputElement>('.filter-price-radio[value="all"]');
        if (allRadio) allRadio.checked = true;
        const discountCheck = document.getElementById('check-only-discounts') as HTMLInputElement | null;
        if (discountCheck) discountCheck.checked = false;
        applyFiltersAndSort();
      }

      // Listeners
      sidebar?.addEventListener('change', applyFiltersAndSort);
      sortSelect?.addEventListener('change', applyFiltersAndSort);
      clearBtn?.addEventListener('click', resetAllFilters);
      resetCtaBtn?.addEventListener('click', () => {
        resetAllFilters();
        if (initialCount === 0 && query) {
          fetchLiveCategoryOffers(query, currentCity);
        }
      });

      // Cambio de ciudad en selector de control
      citySelect?.addEventListener('change', () => {
        currentCity = citySelect.value;
        localStorage.setItem('mercadolista_city', currentCity);
        fetchLiveCategoryOffers(query, currentCity);
      });

      // Botón de refrescar precios
      refreshBtn?.addEventListener('click', () => {
        fetchLiveCategoryOffers(query, currentCity);
      });

      // Eliminar chip individual
      activeChipsEl?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!btn || btn.classList.contains('btn-reset-chips')) return;
        const type = btn.dataset.type;
        const val = btn.dataset.val;

        if (type === 'store' && val) {
          const check = document.querySelector<HTMLInputElement>(`.filter-store-check[value="${val}"]`);
          if (check) check.checked = false;
        } else if (type === 'brand' && val) {
          const check = document.querySelector<HTMLInputElement>(`.filter-brand-check[value="${val}"]`);
          if (check) check.checked = false;
        } else if (type === 'price') {
          const allRadio = document.querySelector<HTMLInputElement>('.filter-price-radio[value="all"]');
          if (allRadio) allRadio.checked = true;
        } else if (type === 'discount') {
          const discountCheck = document.getElementById('check-only-discounts') as HTMLInputElement | null;
          if (discountCheck) discountCheck.checked = false;
        }
        applyFiltersAndSort();
      });

      // INICIO / HIDRATACIÓN AUTOMÁTICA
      // Si SSR vino vacío (0 ofertas), dispara de inmediato la consulta en vivo
      if (initialCount === 0 && query) {
        const storedCity = localStorage.getItem('mercadolista_city');
        if (storedCity && citySelect) {
          citySelect.value = storedCity;
          currentCity = storedCity;
        }
        fetchLiveCategoryOffers(query, currentCity);
      } else {
        applyFiltersAndSort();
      }
    </script>

