      .sort-select {
        background: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.4rem 0.75rem;
        font-size: 0.84rem;
        font-weight: 600;
        color: #1e293b;
        cursor: pointer;
        outline: none;
        transition: border-color 0.15s;
      }

      .sort-select:focus {
        border-color: #0e6a45;
      }

      /* ── Grilla de Tarjetas de Productos ── */
      .product-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 1.25rem;
      }

      .cat-product-card {
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.15rem;
        display: flex;
        flex-direction: column;
        transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s;
        position: relative;
      }

      .cat-product-card:hover {
        transform: translateY(-4px);
        border-color: #0e6a45;
        box-shadow: 0 6px 20px rgba(14, 106, 69, 0.1);
      }

      .card-top-badges {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
      }

      .store-pill {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        background: #f1f5f9;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .store-pill--falabella {
        background: #0e6a45;
        color: #ffffff;
      }

      .store-pill--alkosto, .store-pill--ktronix {
        background: #1e3a8a;
        color: #ffffff;
      }

      .store-pill--exito {
        background: #fef08a;
        color: #854d0e;
      }

      .store-pill--jumbo {
        background: #fee2e2;
        color: #991b1b;
      }

      .store-pill--carulla {
        background: #ecfdf5;
        color: #065f46;
      }

      .store-pill--d1 {
        background: #dbeafe;
        color: #1e40af;
      }

      .discount-pill {
        font-size: 0.72rem;
        font-weight: 800;
        background: #ef4444;
        color: #ffffff;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
      }

      .winner-mini-badge {
        font-size: 0.7rem;
        font-weight: 700;
        color: #0e6a45;
        background: #d1fae5;
        padding: 0.2rem 0.5rem;
        border-radius: 999px;
      }

      .card-thumb-wrap {
        width: 100%;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.85rem;
        padding: 0.5rem;
        background: #fbfcfd;
        border-radius: 10px;
      }

      .card-thumb {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }

      .card-thumb-fallback {
        font-size: 3rem;
      }

      .card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem;
      }

      .card-title {
        font-size: 0.92rem;
        font-weight: 600;
        color: #0f172a;
        line-height: 1.35;
        margin: 0 0 0.35rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .card-unit-price {
        font-size: 0.76rem;
        color: #64748b;
        margin-bottom: 0.4rem;
      }

      .card-pricing {
        margin-top: auto;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }

      .card-current-price {
        font-size: 1.28rem;
        font-weight: 800;
        color: #0e6a45;
      }

      .card-old-price {
        font-size: 0.82rem;
        color: #94a3b8;
        text-decoration: line-through;
      }

      .card-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }

      .btn-card-buy {
        flex: 1;
        background: #0e6a45;
        color: #ffffff;
        text-align: center;
        padding: 0.6rem 0.8rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.82rem;
        transition: background 0.15s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .btn-card-buy:hover {
        background: #084c31;
      }

      .btn-card-add {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1.5px solid #cbd5e1;
        background: #ffffff;
        color: #0e6a45;
        font-size: 0.95rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: all 0.15s;
      }

      .btn-card-add:hover {
        border-color: #0e6a45;
        background: #ecfdf5;
        transform: scale(1.08);
      }

      .no-filter-results {
        text-align: center;
        padding: 3.5rem 1.5rem;
        background: #f8fafc;
        border: 1.5px dashed #cbd5e1;
        border-radius: 16px;
      }

      .no-results-icon {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
      }

      .no-filter-results h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 0.4rem;
      }

      .no-filter-results p {
        font-size: 0.88rem;
        color: #64748b;
        margin: 0 0 1.25rem;
      }

      .btn-reset-filters-cta {
        background: #0e6a45;
        color: #ffffff;
        border: none;
        padding: 0.65rem 1.4rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.88rem;
        cursor: pointer;
      }

      .site-footer {
        text-align: center;
        padding: 2.5rem 1rem;
        color: #94a3b8;
        font-size: 0.82rem;
        border-top: 1px solid #f1f5f9;
        margin-top: 2rem;
      }

      /* ── RESPONSIVE MÓVIL ── */
      @media (max-width: 900px) {
        .cat-layout-wrapper {
          grid-template-columns: 1fr;
        }

        .mobile-filter-trigger-bar {
          display: block;
        }

        .cat-sidebar-col {
          position: fixed;
          top: 0;
          left: 0;
          width: 85%;
          max-width: 320px;
          height: 100vh;
          max-height: 100vh;
          z-index: 9999;
          transform: translateX(-100%);
          transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
          box-shadow: 4px 0 24px rgba(0, 0, 0, 0.2);
          background: #ffffff;
          overflow-y: auto;
          padding: 1rem;
          border-radius: 0;
        }

        .cat-sidebar-col.cat-sidebar--mobile-open {
          transform: translateX(0);
        }

        .btn-close-mobile-filters {
          display: block;
        }
      }

      @media (max-width: 640px) {
        .cat-sidebar-title {
          font-size: 1.4rem;
        }
        .product-cards-grid {
          grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
          gap: 0.85rem;
        }
        .card-thumb-wrap {
          height: 120px;
        }
        .card-current-price {
          font-size: 1.1rem;
        }
        .cat-control-bar {
          flex-direction: column;
          align-items: flex-start;
        }
        .control-bar-right {
          width: 100%;
          justify-content: space-between;
        }
        .sort-select {
          flex: 1;
        }
      }
    </style>
  </body>
</html>
