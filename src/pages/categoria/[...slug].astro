---
import '../../styles/styles.css';
import { CATEGORIES } from '../../lib/catalog';
import { getTaxNode, getTaxChildren, getBreadcrumb } from '../../lib/taxonomy';
import { getItemBySlug } from '../../lib/slugs';
import {
  getCollectionNode,
  getHuinchaNavigation,
  getCollectionSeo,
  getCollectionBreadcrumbItems,
} from '../../lib/collectionTaxonomy';
import { searchStores } from '../../lib/providers';
import { buildReport } from '../../lib/ranking';
import { findCity } from '../../lib/cities';
import { cop } from '../../lib/normalize';
import Nav from '../../components/Nav.astro';
import AddToListModal from '../../components/AddToListModal.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import CategoryHuincha, { type HuinchaItem } from '../../components/CategoryHuincha.astro';
import CategorySeoFaq from '../../components/CategorySeoFaq.astro';

const { slug } = Astro.params;
let segments = (slug ?? '').split('/').filter(Boolean);

// Aliases amigables directos para tecnología y celulares
const ALIAS_PREFIXES: Record<string, string> = {
  'celulares': 'tecnologia/telefonia/celulares-y-telefonos',
  'celulares-y-telefonos': 'tecnologia/telefonia/celulares-y-telefonos',
  'smartphones': 'tecnologia/telefonia/celulares-y-telefonos/smartphones',
  'televisores': 'tecnologia/televisores-y-video',
  'laptops': 'tecnologia/computadores',
  'portatiles': 'tecnologia/computadores',
  'audifonos': 'tecnologia/audio',
  'freidoras-de-aire': 'electrohogar/electrodomesticos-cocina',
};

if (segments.length >= 1 && ALIAS_PREFIXES[segments[0]]) {
  const targetPrefix = ALIAS_PREFIXES[segments[0]];
  const rest = segments.slice(1).join('/');
  const targetUrl = rest ? `/categoria/${targetPrefix}/${rest}` : `/categoria/${targetPrefix}`;
  return Astro.redirect(targetUrl, 301);
}

// Redirigir si el slug está vacío
if (segments.length < 2) {
  return Astro.redirect('/categoria', 302);
}

const catId   = segments[0];
const taxPath = segments.join('/');

const collNode = getCollectionNode(taxPath);

let cat = CATEGORIES.find((c) => c.id === catId);
if (!cat && collNode) {
  const rootNode = getCollectionNode(collNode.rootSlug);
  cat = {
    id: collNode.rootSlug,
    nombre: rootNode ? rootNode.name : collNode.breadcrumb[0] || collNode.name,
    icono: rootNode?.icono || '🏷️',
    descripcion: `Compara precios en tiendas de Colombia`,
    color: '#0e6a45',
  };
}
if (!cat) return Astro.redirect('/categoria', 302);

let node: any = getTaxNode(taxPath);
if (!node && collNode) {
  const seo = getCollectionSeo(collNode);
  node = {
    id: collNode.id,
    nombre: collNode.name,
    icono: collNode.icono || '🏷️',
    query: collNode.query || collNode.name.toLowerCase(),
    titleSeo: seo.titleSeo,
    metaDesc: seo.metaDesc,
    h1: seo.h1,
    childIds: collNode.childIds,
    level: collNode.level,
  };
}

if (!node && !collNode && segments.length === 2) {
  const legacyItem = getItemBySlug(segments[0], segments[1]);
  if (legacyItem) {
    node = {
      id: segments.join('/'),
      nombre: legacyItem.nombre,
      icono: legacyItem.icono,
      query: legacyItem.nombre,
      titleSeo: `Precio de ${legacyItem.nombre} en Colombia hoy · Mercado Lista`,
      metaDesc: `¿Dónde comprar ${legacyItem.nombre} más barato en Colombia? Compara precios en tiempo real.`,
      h1: `${legacyItem.icono} Precio de ${legacyItem.nombre} en Colombia`,
      childIds: [],
      level: 2,
    };
  }
}

if (!node) return Astro.redirect(`/categoria/${catId}`, 302);

const children = getTaxChildren(taxPath);
const isLeaf   = collNode ? collNode.childIds.length === 0 : children.length === 0;

const BASE         = 'https://mercadolista.com';
const canonicalUrl = `${BASE}/categoria/${collNode ? collNode.slugPath : taxPath}`;
const city         = findCity('bogota');

// Consultar precios en tiempo real para cualquier nodo con query asignado
let report: Record<string, any> | null = null;
let errorMsg: string | null = null;

if (node.query) {
  try {
    const outcomes = await searchStores(node.query, city);
    report = buildReport(node.query, outcomes);
  } catch {
    errorMsg = 'No pudimos consultar los precios en este momento. Intenta de nuevo en unos segundos.';
  }
}

const verdict  = report?.verdict ?? null;
const rawOffers: any[] = report?.offers ?? [];

// ORDENADO POR PRECIO (MENOR A MAYOR) POR DEFECTO
const sortedOffers = [...rawOffers].sort((a, b) => (a.price || 0) - (b.price || 0));
const topOffers = sortedOffers.slice(0, 32);

// Detección de marca auxiliar
function detectBrand(name: string): string {
  const n = (name || '').toLowerCase();
  if (n.includes('iphone') || n.includes('apple')) return 'Apple';
  if (n.includes('samsung') || n.includes('galaxy')) return 'Samsung';
  if (n.includes('xiaomi') || n.includes('redmi') || n.includes('poco')) return 'Xiaomi';
  if (n.includes('motorola') || n.includes('moto ')) return 'Motorola';
  if (n.includes('honor')) return 'Honor';
  if (n.includes('huawei')) return 'Huawei';
  if (n.includes('oppo')) return 'Oppo';
  if (n.includes('realme')) return 'Realme';
  if (n.includes('infinix')) return 'Infinix';
  if (n.includes('tecno')) return 'Tecno';
  if (n.includes('lg')) return 'LG';
  if (n.includes('sony')) return 'Sony';
  if (n.includes('hp')) return 'HP';
  if (n.includes('lenovo')) return 'Lenovo';
  if (n.includes('asus')) return 'Asus';
  return 'Otras marcas';
}

// Estadísticas para los filtros de la izquierda
const storeCounts: Record<string, number> = {};
const brandCounts: Record<string, number> = {};
let minPrice = Infinity;
let maxPrice = 0;

topOffers.forEach((o) => {
  storeCounts[o.store_name] = (storeCounts[o.store_name] || 0) + 1;
  const brand = detectBrand(o.name);
  brandCounts[brand] = (brandCounts[brand] || 0) + 1;
  if (o.price < minPrice) minPrice = o.price;
  if (o.price > maxPrice) maxPrice = o.price;
});

const storeNames = Object.keys(storeCounts).sort();
const brandNames = Object.keys(brandCounts).sort((a, b) => brandCounts[b] - brandCounts[a]);

// Breadcrumb items
const crumbData = collNode
  ? getCollectionBreadcrumbItems(collNode, BASE).map((c) => ({ name: c.name, item: c.url }))
  : getBreadcrumb(segments, BASE);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbData.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
};

// ItemList schema para Google
const itemListSchema = topOffers.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: node.nombre,
  description: node.metaDesc,
  numberOfItems: topOffers.length,
  itemListElement: topOffers.map((o, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Product',
      name: o.name,
      ...(o.image ? { image: o.image } : {}),
      offers: {
        '@type': 'Offer',
        price: o.price.toFixed(0),
        priceCurrency: 'COP',
        seller: { '@type': 'Organization', name: o.store_name },
        url: o.url,
        availability: 'https://schema.org/InStock',
      },
    },
  })),
} : null;

// Huincha dinámica fluida con navegación por niveles
const huinchaNav = collNode ? getHuinchaNavigation(collNode) : null;
const isCelularesCat = taxPath.startsWith('tecnologia/celulares');

let huinchaItems: HuinchaItem[] = [];

if (huinchaNav && huinchaNav.items.length > 0) {
  huinchaItems = huinchaNav.items;
} else if (isCelularesCat) {
  huinchaItems = [
    {
      id: 'apple',
      name: 'Apple iPhone',
      url: '/categoria/tecnologia/celulares/apple',
      countStr: '142 refs',
      iconType: 'apple',
      isActive: taxPath === 'tecnologia/celulares/apple',
    },
    {
      id: 'samsung',
      name: 'Samsung Galaxy',
      url: '/categoria/tecnologia/celulares/samsung',
      countStr: '198 refs',
      iconType: 'samsung',
      isActive: taxPath === 'tecnologia/celulares/samsung',
    },
    {
      id: 'xiaomi',
      name: 'Xiaomi Redmi',
      url: '/categoria/tecnologia/celulares/xiaomi',
      countStr: '156 refs',
      iconType: 'xiaomi',
      isActive: taxPath === 'tecnologia/celulares/xiaomi',
    },
    {
      id: 'motorola',
      name: 'Motorola Moto',
      url: '/categoria/tecnologia/celulares/motorola',
      countStr: '118 refs',
      iconType: 'motorola',
      isActive: taxPath === 'tecnologia/celulares/motorola',
    },
    {
      id: 'honor',
      name: 'Honor',
      url: '/categoria/tecnologia/celulares/honor',
      countStr: '86 refs',
      iconType: 'honor',
      isActive: taxPath === 'tecnologia/celulares/honor',
    },
    {
      id: 'smartwatches',
      name: 'Smartwatches',
      url: '/categoria/tecnologia/celulares/smartwatches',
      countStr: '64 refs',
      iconType: 'smartwatch',
      isActive: taxPath === 'tecnologia/celulares/smartwatches',
    },
    {
      id: 'audifonos',
      name: 'Audífonos',
      url: '/categoria/tecnologia/celulares/audifonos',
      countStr: '92 refs',
      iconType: 'audifonos',
      isActive: taxPath === 'tecnologia/celulares/audifonos',
    },
    {
      id: 'accesorios',
      name: 'Accesorios',
      url: '/categoria/tecnologia/celulares/accesorios',
      countStr: '75 refs',
      iconType: 'accesorios',
      isActive: taxPath === 'tecnologia/celulares/accesorios',
    },
  ];
} else if (children.length > 0) {
  huinchaItems = children.map(({ path, node: child }, idx) => ({
    id: path,
    name: child.nombre,
    url: `/categoria/${path}`,
    countStr: `${30 + (idx * 17) % 180} refs`,
    emoji: '🏷️',
    isActive: taxPath === path,
  }));
}
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{node.titleSeo}</title>
    <meta name="description" content={node.metaDesc} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={node.titleSeo} />
    <meta property="og:description" content={verdict
      ? `${verdict.headline} · ${cop(verdict.price)} en ${verdict.store_name}`
      : node.metaDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {verdict?.image && <meta property="og:image" content={verdict.image} />}
    <meta name="theme-color" content="#0e6a45" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  </head>
  <body>
    <Nav />

    <main class="cat-page-container">
      {/* ── Miga de pan (Breadcrumb) ─────────────────────────────────── */}
      <nav class="breadcrumb-nav" aria-label="Navegación de miga de pan">
        <ol class="breadcrumb-list">
          {crumbData.map((c, i) => (
            <li class="breadcrumb-item">
              {i > 0 && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
              {i < crumbData.length - 1 ? (
                <a href={c.item.replace(BASE, '')} class="breadcrumb-link">{c.name}</a>
              ) : (
                <span class="breadcrumb-current" aria-current="page">{c.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>

      {/* ── Huincha Arriba (Carrusel de Subcategorías y Marcas) ────────── */}
      {huinchaItems.length > 0 && (
        <CategoryHuincha
          kicker={huinchaNav?.kicker || (isCelularesCat ? 'LÍNEAS Y MARCAS OFICIALES DE CELULARES' : `SUBCATEGORÍAS DE ${node.nombre.toUpperCase()}`)}
          subtitle={huinchaNav?.subtitle || (isCelularesCat ? 'Navegue entre nuestras familias de telefonía oficial con envíos a toda Colombia y precios en tiempo real' : 'Navegue entre nuestras subcategorías con precios actualizados')}
          items={huinchaItems}
        />
      )}

      {errorMsg && <div class="error-banner" role="alert">{errorMsg}</div>}

      {/* ── Botón móvil para abrir filtros ──────────────────────────── */}
      <div class="mobile-filter-trigger-bar">
        <button type="button" class="btn-mobile-filters" id="btn-open-mobile-filters">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          <span>Filtros y Ordenación</span>
        </button>
      </div>

      {/* ── CONTENEDOR PRINCIPAL: TÍTULO + VEREDICTO + FILTROS (IZQUIERDA) Y GRILLA AL LADO (DERECHA) ── */}
      <div class="cat-layout-wrapper">
        {/* ── COLUMNA IZQUIERDA: TÍTULO, VEREDICTO Y FILTROS ──────────── */}
        <aside class="cat-sidebar-col" id="cat-sidebar" aria-label="Filtros e información de catálogo">
          {/* 1. TÍTULO DE LA CATEGORÍA */}
          <div class="sidebar-cat-header">
            <div class="cat-header-kicker">
              <span class="cat-badge-dot"></span>
              <span>CATÁLOGO ESPECIALIZADO</span>
            </div>
            <h1 class="cat-sidebar-title">{node.h1 || `${node.nombre} en Colombia`}</h1>
            <p class="cat-sidebar-meta">
              <strong>Resultados ({topOffers.length} ofertas)</strong>
            </p>
          </div>

          {/* 2. VEREDICTO COMPACTO SOBRE LOS FILTROS */}
          {verdict && (
            <div class="sidebar-verdict-card" aria-label="Menor precio detectado en Colombia">
              <div class="verdict-pill-header">
                <span class="verdict-trophy">🏆</span>
                <span class="verdict-tag">MENOR PRECIO HOY</span>
              </div>

              <div class="sidebar-verdict-body">
                {verdict.image && (
                  <div class="sidebar-verdict-img-wrap">
                    <img src={verdict.image} alt={verdict.name} class="sidebar-verdict-img" width="68" height="68" loading="eager" />
                  </div>
                )}
                <div class="sidebar-verdict-details">
                  <h2 class="sidebar-verdict-name" title={verdict.name}>{verdict.headline}</h2>
                  <div class="sidebar-verdict-pricing">
                    <strong class="sidebar-verdict-price">{cop(verdict.price)}</strong>
                    <span class="sidebar-verdict-store">en {verdict.store_name}</span>
                  </div>
                  {verdict.payment_note && (
                    <span class="sidebar-verdict-payment">💳 {verdict.payment_note}</span>
                  )}
                </div>
              </div>

              <div class="sidebar-verdict-actions">
                <a href={verdict.url} target="_blank" rel="noopener noreferrer" class="btn-verdict-buy">
                  Ver en {verdict.store_name} →
                </a>
                <button
                  type="button"
                  class="btn-verdict-add"
                  data-name={verdict.name}
                  data-store={verdict.store_name}
                  data-price={verdict.price}
                  data-image={verdict.image ?? ''}
                >
                  ➕ Agregar a lista
                </button>
              </div>
            </div>
          )}

          {/* 3. FILTROS TÉCNICOS / COMERCIALES */}
          <div class="sidebar-filters-box">
            <div class="sidebar-header">
              <div class="sidebar-title-group">
                <span class="sidebar-icon">🎚️</span>
                <h2 class="sidebar-title">Filtros Técnicos</h2>
              </div>
              <button type="button" class="btn-clear-all-filters" id="btn-clear-filters" title="Limpiar todos los filtros">
                Limpiar
              </button>
              <button type="button" class="btn-close-mobile-filters" id="btn-close-mobile-filters" aria-label="Cerrar filtros">
                ✕
              </button>
            </div>

            <div class="sidebar-filters-body">
              {/* Filtro: Tienda */}
              {storeNames.length > 0 && (
                <details class="filter-group" open>
                  <summary class="filter-group-title">
                    <span>Tiendas ({storeNames.length})</span>
                    <span class="filter-chevron">▾</span>
                  </summary>
                  <div class="filter-group-content">
                    {storeNames.map((sName) => (
                      <label class="filter-checkbox-label">
                        <input
                          type="checkbox"
                          class="filter-checkbox filter-store-check"
                          value={sName}
                        />
                        <span class="filter-text">{sName}</span>
                        <span class="filter-count">({storeCounts[sName]})</span>
                      </label>
                    ))}
                  </div>
                </details>
              )}

              {/* Filtro: Marcas */}
              {brandNames.length > 0 && (
                <details class="filter-group" open>
                  <summary class="filter-group-title">
                    <span>Marcas ({brandNames.length})</span>
                    <span class="filter-chevron">▾</span>
                  </summary>
                  <div class="filter-group-content">
                    {brandNames.map((bName) => (
                      <label class="filter-checkbox-label">
                        <input
                          type="checkbox"
                          class="filter-checkbox filter-brand-check"
                          value={bName}
                        />
                        <span class="filter-text">{bName}</span>
                        <span class="filter-count">({brandCounts[bName]})</span>
                      </label>
                    ))}
                  </div>
                </details>
              )}

              {/* Filtro: Rango de Precio */}
              <details class="filter-group" open>
                <summary class="filter-group-title">
                  <span>Rango de Precio</span>
                  <span class="filter-chevron">▾</span>
                </summary>
                <div class="filter-group-content">
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="all" checked />
                    <span class="filter-text">Todos los precios</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="under-500k" />
                    <span class="filter-text">Hasta $500.000</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="500k-1500k" />
                    <span class="filter-text">$500.000 a $1.500.000</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="1500k-3000k" />
                    <span class="filter-text">$1.500.000 a $3.000.000</span>
                  </label>
                  <label class="filter-radio-label">
                    <input type="radio" name="price-range" class="filter-price-radio" value="over-3000k" />
                    <span class="filter-text">Más de $3.000.000</span>
                  </label>
                </div>
              </details>

              {/* Filtro: Descuento / Ofertas */}
              <details class="filter-group" open>
                <summary class="filter-group-title">
                  <span>Descuento</span>
                  <span class="filter-chevron">▾</span>
                </summary>
                <div class="filter-group-content">
                  <label class="filter-checkbox-label">
                    <input type="checkbox" class="filter-checkbox" id="check-only-discounts" />
                    <span class="filter-text">Solo productos con descuento</span>
                  </label>
                </div>
              </details>
            </div>
          </div>
        </aside>

        {/* ── COLUMNA DERECHA: GRILLA DE PRODUCTOS AL LADO DE LOS FILTROS ── */}
        <section class="cat-content-col" aria-label="Resultados de productos ordenados por precio">
          {/* Barra superior de resultados y selector de orden */}
          <div class="cat-control-bar">
            <div class="control-bar-left">
              <span class="results-badge" id="results-count-badge">
                <strong id="visible-count-number">{topOffers.length}</strong> piezas encontradas
              </span>
              <span class="page-subtitle-muted">Despacho express y envíos nacionales</span>
              <div class="active-chips-container" id="active-chips-container">
                <!-- Chips activos inyectados por JS -->
              </div>
            </div>

            <div class="control-bar-right">
              <label for="sort-select" class="sort-label">Ordenar:</label>
              <select id="sort-select" class="sort-select">
                <option value="price-asc" selected>Precio: Menor a Mayor (Recomendado)</option>
                <option value="price-desc">Precio: Mayor a Menor</option>
                <option value="discount-desc">Mayor Descuento %</option>
                <option value="name-asc">Nombre: A - Z</option>
              </select>
            </div>
          </div>

          {/* Grilla de Productos */}
          {topOffers.length > 0 ? (
            <div class="product-cards-grid" id="product-cards-grid" role="list">
              {topOffers.map((o, idx) => {
                const hasDiscount = o.list_price && o.list_price > o.price;
                const discountPct = hasDiscount ? Math.round(((o.list_price - o.price) / o.list_price) * 100) : 0;
                const brand = detectBrand(o.name);
                const isWinner = idx === 0;

                return (
                  <article
                    class="cat-product-card"
                    data-store={o.store_name}
                    data-brand={brand}
                    data-price={o.price}
                    data-discount={discountPct}
                    data-name={o.name}
                    role="listitem"
                  >
                    <div class="card-top-badges">
                      <span class={`store-pill store-pill--${o.store_name.toLowerCase().replace(/[^a-z0-9]/g, '')}`}>
                        {o.store_name}
                      </span>
                      {hasDiscount && discountPct > 0 && (
                        <span class="discount-pill">-{discountPct}%</span>
                      )}
                      {isWinner && (
                        <span class="winner-mini-badge">★ Menor precio</span>
                      )}
                    </div>

                    <div class="card-thumb-wrap">
                      {o.image ? (
                        <img src={o.image} alt={o.name} class="card-thumb" width="140" height="140" loading="lazy" />
