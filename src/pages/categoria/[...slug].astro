                        class="btn-card-add"
                        data-name={o.name}
                        data-store={o.store_name}
                        data-price={o.price}
                        data-image={o.image ?? ''}
                        title="Añadir a mi lista de compras activa"
                      >
                        ➕
                      </button>
                    </div>
                  </article>
                );
              })}
            </div>
          ) : null}

          {/* Estado de sin resultados */}
          <div class="no-filter-results" id="no-filter-results" style={topOffers.length > 0 ? "display: none;" : "display: block;"}>
