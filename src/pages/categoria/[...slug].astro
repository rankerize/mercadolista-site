---
import '../../styles/styles.css';
import { CATEGORIES } from '../../lib/catalog';
import { getTaxNode, getTaxChildren, getBreadcrumb } from '../../lib/taxonomy';
import { getItemBySlug } from '../../lib/slugs';
import {
  getCollectionNode,
  getHuinchaNavigation,
  getCollectionSeo,
  getCollectionBreadcrumbItems,
} from '../../lib/collectionTaxonomy';
import { searchStores } from '../../lib/providers';
import { buildReport } from '../../lib/ranking';
import { findCity } from '../../lib/cities';
import { cop } from '../../lib/normalize';
import Nav from '../../components/Nav.astro';
import AddToListModal from '../../components/AddToListModal.astro';
import PlpView from '../../components/PlpView.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';

const { slug } = Astro.params;
let segments = (slug ?? '').split('/').filter(Boolean);

// Aliases amigables directos para tecnología y celulares
const ALIAS_PREFIXES: Record<string, string> = {
  'celulares': 'tecnologia/telefonia/celulares-y-telefonos',
  'celulares-y-telefonos': 'tecnologia/telefonia/celulares-y-telefonos',
  'smartphones': 'tecnologia/telefonia/celulares-y-telefonos/smartphones',
  'televisores': 'tecnologia/televisores-y-video',
  'laptops': 'tecnologia/computadores',
  'portatiles': 'tecnologia/computadores',
  'audifonos': 'tecnologia/audio',
  'freidoras-de-aire': 'electrohogar/electrodomesticos-cocina',
};

if (segments.length >= 1 && ALIAS_PREFIXES[segments[0]]) {
  const targetPrefix = ALIAS_PREFIXES[segments[0]];
  const rest = segments.slice(1).join('/');
  const targetUrl = rest ? `/categoria/${targetPrefix}/${rest}` : `/categoria/${targetPrefix}`;
  return Astro.redirect(targetUrl, 301);
}

// Redirigir si el slug está vacío
if (segments.length < 2) {
  return Astro.redirect('/categoria', 302);
}

const catId   = segments[0];
const taxPath = segments.join('/');

const collNode = getCollectionNode(taxPath);

let cat = CATEGORIES.find((c) => c.id === catId);
if (!cat && collNode) {
  const rootNode = getCollectionNode(collNode.rootSlug);
  cat = {
    id: collNode.rootSlug,
    nombre: rootNode ? rootNode.name : collNode.breadcrumb[0] || collNode.name,
    icono: rootNode?.icono || '🏷️',
    descripcion: `Compara precios en tiendas de Colombia`,
    color: '#0e6a45',
  };
}
if (!cat) return Astro.redirect('/categoria', 302);

let node: any = getTaxNode(taxPath);
if (!node && collNode) {
  const seo = getCollectionSeo(collNode);
  node = {
    id: collNode.id,
    nombre: collNode.name,
    icono: collNode.icono || '🏷️',
    query: collNode.query || collNode.name.toLowerCase(),
    titleSeo: seo.titleSeo,
    metaDesc: seo.metaDesc,
    h1: seo.h1,
    childIds: collNode.childIds,
    level: collNode.level,
  };
}

if (!node && !collNode && segments.length === 2) {
  const legacyItem = getItemBySlug(segments[0], segments[1]);
  if (legacyItem) {
    node = {
      id: segments.join('/'),
      nombre: legacyItem.nombre,
      icono: legacyItem.icono,
      query: legacyItem.nombre,
      titleSeo: `Precio de ${legacyItem.nombre} en Colombia hoy · Mercado Lista`,
      metaDesc: `¿Dónde comprar ${legacyItem.nombre} más barato en Colombia? Compara precios en tiempo real.`,
      h1: `${legacyItem.icono} Precio de ${legacyItem.nombre} en Colombia`,
      childIds: [],
      level: 2,
    };
  }
}

if (!node) return Astro.redirect(`/categoria/${catId}`, 302);

const children = getTaxChildren(taxPath);
const isLeaf   = collNode ? collNode.childIds.length === 0 : children.length === 0;

const BASE         = 'https://mercadolista.com';
const canonicalUrl = `${BASE}/categoria/${collNode ? collNode.slugPath : taxPath}`;
const ciudadParam  = Astro.url.searchParams.get('ciudad') || 'bogota';
const city         = findCity(ciudadParam);

// Consultar precios en tiempo real para cualquier nodo con query asignado
// Timeout protector de 4s para SSR veloz: si tarda más, el cliente hidrata en vivo
let report: Record<string, any> | null = null;
let errorMsg: string | null = null;

if (node.query) {
  try {
    const searchPromise = searchStores(node.query, city);
    const timeoutPromise = new Promise<never>((_, reject) =>
      setTimeout(() => reject(new Error('SSR timeout')), 4000)
    );
    const outcomes = (await Promise.race([searchPromise, timeoutPromise])) as any;
    report = buildReport(node.query, outcomes);
  } catch {
    // Si da timeout o error en SSR, no bloqueamos la renderización:
    // El cliente hidratará automáticamente en tiempo real con /api/buscar
  }
}

const verdict  = report?.verdict ?? null;
const rawOffers: any[] = report?.offers ?? [];

// ORDENADO POR PRECIO (MENOR A MAYOR) POR DEFECTO
const sortedOffers = [...rawOffers].sort((a, b) => (a.price || 0) - (b.price || 0));
const topOffers = sortedOffers.slice(0, 200);

// Breadcrumb items
const crumbData = collNode
  ? getCollectionBreadcrumbItems(collNode, BASE).map((c) => ({ name: c.name, item: c.url }))
  : getBreadcrumb(segments, BASE);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbData.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.item,
  })),
};

// ItemList schema para Google
const itemListSchema = topOffers.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: node.nombre,
  description: node.metaDesc,
  numberOfItems: topOffers.length,
  itemListElement: topOffers.map((o, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Product',
      name: o.name,
      ...(o.image ? { image: o.image } : {}),
      offers: {
        '@type': 'Offer',
        price: o.price.toFixed(0),
        priceCurrency: 'COP',
        seller: { '@type': 'Organization', name: o.store_name },
        url: o.url,
        availability: 'https://schema.org/InStock',
      },
    },
  })),
} : null;

// Huincha dinámica fluida con navegación por niveles
const huinchaNav = collNode ? getHuinchaNavigation(collNode) : null;
const isCelularesCat = taxPath.startsWith('tecnologia/celulares');

let huinchaItems: HuinchaItem[] = [];

if (huinchaNav && huinchaNav.items.length > 0) {
  huinchaItems = huinchaNav.items;
} else if (isCelularesCat) {
  huinchaItems = [
    {
      id: 'apple',
      name: 'Apple iPhone',
      url: '/categoria/tecnologia/celulares/apple',
      countStr: '142 refs',
      iconType: 'apple',
      isActive: taxPath === 'tecnologia/celulares/apple',
    },
    {
      id: 'samsung',
      name: 'Samsung Galaxy',
      url: '/categoria/tecnologia/celulares/samsung',
      countStr: '198 refs',
      iconType: 'samsung',
      isActive: taxPath === 'tecnologia/celulares/samsung',
    },
    {
      id: 'xiaomi',
      name: 'Xiaomi Redmi',
      url: '/categoria/tecnologia/celulares/xiaomi',
      countStr: '156 refs',
      iconType: 'xiaomi',
      isActive: taxPath === 'tecnologia/celulares/xiaomi',
    },
    {
      id: 'motorola',
      name: 'Motorola Moto',
      url: '/categoria/tecnologia/celulares/motorola',
      countStr: '118 refs',
      iconType: 'motorola',
      isActive: taxPath === 'tecnologia/celulares/motorola',
    },
    {
      id: 'honor',
      name: 'Honor',
      url: '/categoria/tecnologia/celulares/honor',
      countStr: '86 refs',
      iconType: 'honor',
      isActive: taxPath === 'tecnologia/celulares/honor',
    },
    {
      id: 'smartwatches',
      name: 'Smartwatches',
      url: '/categoria/tecnologia/celulares/smartwatches',
      countStr: '64 refs',
      iconType: 'smartwatch',
      isActive: taxPath === 'tecnologia/celulares/smartwatches',
    },
    {
      id: 'audifonos',
      name: 'Audífonos',
      url: '/categoria/tecnologia/celulares/audifonos',
      countStr: '92 refs',
      iconType: 'audifonos',
      isActive: taxPath === 'tecnologia/celulares/audifonos',
    },
    {
      id: 'accesorios',
      name: 'Accesorios',
      url: '/categoria/tecnologia/celulares/accesorios',
      countStr: '75 refs',
      iconType: 'accesorios',
      isActive: taxPath === 'tecnologia/celulares/accesorios',
    },
  ];
} else if (children.length > 0) {
  huinchaItems = children.map(({ path, node: child }, idx) => ({
    id: path,
    name: child.nombre,
    url: `/categoria/${path}`,
    countStr: `${30 + (idx * 17) % 180} refs`,
    emoji: '🏷️',
    isActive: taxPath === path,
  }));
}
const huinchaKicker = huinchaNav?.kicker || (isCelularesCat ? 'LÍNEAS Y MARCAS OFICIALES DE CELULARES' : `SUBCATEGORÍAS DE ${node.nombre.toUpperCase()}`);
const huinchaSubtitle = huinchaNav?.subtitle || (isCelularesCat ? 'Navegue entre nuestras familias de telefonía oficial con envíos a toda Colombia y precios en tiempo real' : 'Navegue entre nuestras subcategorías con precios actualizados');

---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{node.titleSeo}</title>
    <meta name="description" content={node.metaDesc} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={node.titleSeo} />
    <meta property="og:description" content={verdict
      ? `${verdict.headline} · ${cop(verdict.price)} en ${verdict.store_name}`
      : node.metaDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {verdict?.image && <meta property="og:image" content={verdict.image} />}
    <meta name="theme-color" content="#0e6a45" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  </head>
  <body>
    <Nav />

    <PlpView
      h1={node.h1 || `${node.nombre} en Colombia`}
      nombre={node.nombre}
      query={node.query || ''}
      city={city}
      crumbs={crumbData}
      offers={topOffers}
      verdict={verdict}
      errorMsg={errorMsg}
      huinchaItems={huinchaItems}
      huinchaKicker={huinchaKicker}
      huinchaSubtitle={huinchaSubtitle}
      showFaq
      isTechCategory={catId === 'tecnologia'}
    />


    <AddToListModal />

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Mercado Lista · Comparador de precios en tiempo real para Colombia</p>
    </footer>

    {/* Scripts interactivos para hidratación en tiempo real, filtros laterales, ordenación instantánea y modal de listas */}
    <style>
      .site-footer {
        text-align: center;
        padding: 2.5rem 1rem;
        color: #94a3b8;
        font-size: 0.82rem;
        border-top: 1px solid #f1f5f9;
        margin-top: 2rem;
      }
    </style>
  </body>
</html>
