---
import '../../styles/styles.css';
import { CATEGORIES, getItemsByCategory } from '../../lib/catalog';
import { getRootDepartments } from '../../lib/collectionTaxonomy';
import Nav from '../../components/Nav.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';

const BASE = 'https://mercadolista.com';
const rootDepartments = getRootDepartments();
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Directorio de Categorías y Departamentos · Mercado Lista</title>
    <meta name="description" content="Explora más de 3,200 categorías de compras en Colombia: supermercado, tecnología, hogar, moda, deportes y más. Compara precios en tiempo real." />
    <link rel="canonical" href={`${BASE}/categoria`} />
    <meta name="theme-color" content="#0e6a45" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: BASE },
        { '@type': 'ListItem', position: 2, name: 'Categorías', item: `${BASE}/categoria` },
      ],
    })} />
  </head>
  <body>
    <Nav />
    <header class="top">
      <h1>Directorio de Categorías</h1>
      <p class="lead">Compara precios en tiempo real entre los principales retailers y supermercados de Colombia.</p>
    </header>

    <main class="cat-index">
      <nav class="breadcrumb" aria-label="Navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Categorías</span>
      </nav>

      <!-- Departamentos principales del árbol e-commerce -->
      <section style="margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.35rem; color: var(--ink); margin-bottom: 1.25rem;">
          Departamentos y Colecciones ({rootDepartments.length})
        </h2>
        <ul class="cat-grid" role="list">
          {rootDepartments.map((dept) => (
            <li>
              <a href={`/categoria/${dept.slugPath}`} class="cat-card">
                <span class="cat-icon">{dept.icono}</span>
                <div class="cat-info">
                  <strong>{dept.name}</strong>
                  <span class="cat-count">{dept.childIds.length} subfamilias</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Canasta Familiar y Supermercado Rápido -->
      <section>
        <h2 style="font-size: 1.25rem; color: var(--ink); margin-bottom: 1rem;">
          🛒 Canasta Básica y Supermercado Popular
        </h2>
        <ul class="cat-grid" role="list">
          {CATEGORIES.map((cat) => {
            const items = getItemsByCategory(cat.id);
            return (
              <li>
                <a href={`/categoria/${cat.id}`} class="cat-card cat-card--super">
                  <span class="cat-icon">{cat.icono}</span>
                  <div class="cat-info">
                    <strong>{cat.nombre}</strong>
                    <span class="cat-count">{items.length} productos frecuentes</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Mercado Lista · Precios consultados en tiempo real en Colombia</p>
    </footer>

    <style>
      .cat-index { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
      .breadcrumb { display: flex; gap: 0.5rem; align-items: center; font-size: 0.875rem; color: #666; margin-bottom: 1.5rem; }
      .breadcrumb a { color: #0e6a45; text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1rem; list-style: none; margin: 0; padding: 0; }
      .cat-card { display: flex; align-items: center; gap: 1rem; padding: 1.1rem; border: 1.5px solid var(--line, #e2e8f0); border-radius: 12px; text-decoration: none; color: inherit; background: var(--card, #fff); transition: all 0.15s ease; }
      .cat-card:hover { border-color: #0e6a45; box-shadow: 0 4px 14px rgba(14,106,69,0.12); transform: translateY(-1px); }
      .cat-card--super { background: #fbfdfc; border-color: #d1fae5; }
      .cat-icon { font-size: 1.85rem; flex-shrink: 0; }
      .cat-info { display: flex; flex-direction: column; gap: 0.2rem; }
      .cat-info strong { font-size: 0.95rem; color: var(--ink); }
      .cat-count { font-size: 0.78rem; color: var(--muted, #666); }
      .site-footer { text-align: center; padding: 2rem 1rem; color: #999; font-size: 0.8rem; border-top: 1px solid #f0f0f0; }
    </style>
  </body>
</html>
</html>
