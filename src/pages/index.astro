---
import '../styles/styles.css';
import { CATEGORIES } from '../lib/catalog';
import Nav from '../components/Nav.astro';
import ShareModal from '../components/ShareModal.astro';
import AddToListModal from '../components/AddToListModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import AssistantChatWidget from '../components/AssistantChatWidget.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="IY3hmno8L66fxtrNuqP9wJifpSpyeVbV6MtYlwmhVAk" />
    <title>Mercado Lista · Comparador de precios en Colombia</title>
    <meta name="description" content="Compara precios en tiempo real entre tiendas de Colombia (Éxito, Carulla, Jumbo, Olímpica, D1, Alkosto, Falabella) e internacionales (Amazon, eBay, AliExpress). Ahorra en tu mercado." />
    <link rel="canonical" href="https://mercadolista.com/" />
    <meta property="og:title" content="Mercado Lista · Comparador de precios en Colombia" />
    <meta property="og:description" content="Compara precios en tiempo real entre supermercados y tecnología en Colombia. Encuentra el mejor precio por producto, por unidad o para tu lista completa." />
    <meta property="og:url" content="https://mercadolista.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://mercadolista.com/logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://mercadolista.com/logo.png" />
    <meta name="theme-color" content="#0e6a45" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mercado Lista" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />

    <header class="top">
      <h1 class="hero-title">
        <img src="/logo-canasta.png" alt="" width="436" height="398" />
        <span>¿Dónde conviene comprarlo?</span>
      </h1>
      <p class="lead" id="lead">
        Compara el precio publicado en tiendas de Colombia y te dice en cuál está el más bajo.
      </p>
    </header>

    <main>
      <div class="tabs" role="tablist">
        <button type="button" id="tab-local" class="tab is-active" data-mode="local" role="tab" aria-selected="true">
          Que Quieres comprar
        </button>
        <button type="button" id="tab-unit" class="tab" data-mode="unit" role="tab" aria-selected="false">
          Compra x Unidad
        </button>
        <button type="button" id="tab-list" class="tab" data-mode="list" role="tab" aria-selected="false">
          Lista de Compras
        </button>
        <button type="button" id="tab-intl" class="tab" data-mode="intl" role="tab" aria-selected="false">
          Compras Internacionales
        </button>
      </div>

      <form id="search-form" class="search">
        <div class="city-row" id="city-row">
          <label for="city">Ciudad</label>
          <select id="city" name="ciudad">
            <option value="bogota" selected>Bogotá</option>
          </select>
        </div>

        <div id="unit-filters" class="unit-filters" hidden>
          <div>
            <label for="unit-basis">Unidad</label>
            <select id="unit-basis" name="unidad">
              <option value="todas" selected>Todas</option>
              <option value="mililitros">Mililitros</option>
              <option value="gramos">Gramos</option>
              <option value="unidades">Unidades</option>
            </select>
          </div>
          <div>
            <label for="unit-min" id="unit-min-label">Cantidad mínima</label>
            <input
              id="unit-min"
              name="minimo"
              type="number"
              inputmode="decimal"
              min="0"
              step="any"
              placeholder="Elige una unidad"
              disabled
            />
          </div>
          <div>
            <label for="unit-category">Categoría</label>
            <select id="unit-category" name="categoria">
              <option value="todas" selected>Todas</option>
              {CATEGORIES.map((category) => (
                <option value={category.id}>{category.icono} {category.nombre}</option>
              ))}
            </select>
          </div>
        </div>

        <div id="single-search">
          <label for="query">Producto</label>
          <div class="search-row" style="position: relative;">
            <input
              id="query"
              name="q"
              type="search"
              placeholder="Ej. leche entera colanta, arroz roa, televisor 55"
              autocomplete="off"
              required
              minlength="2"
              maxlength="80"
            />
            <button type="submit" id="submit">Comparar</button>
            <div id="query-autocomplete" class="autocomplete-dropdown" style="top: 100%; left: 0; margin-top: 4px;"></div>
          </div>
        </div>

        <div id="list-editor" class="list-editor" hidden>
          <div id="account" class="account">
            <div id="account-out">
              <p class="account-title">Inicia sesión para guardar y sincronizar tus listas de mercado.</p>
              <div class="account-fields" style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.75rem;">
                <button type="button" id="account-google-btn" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fff; color: #333; border: 1px solid #ccc; font-weight: 500; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer;">
                  <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                  </svg>
                  Iniciar sesión con Google
                </button>
              </div>
            </div>

            <div id="account-in" hidden>
              <div class="account-head">
                <p class="account-title" id="account-hello"></p>
                <button type="button" id="account-logout" class="ghost">Salir</button>
              </div>
              <div class="account-fields saved-lists">
                <label class="list-field">
                  <span>Mis listas</span>
                  <select id="saved-select"></select>
                </label>
                <label class="list-field">
                  <span>Nombre de la lista</span>
                  <input id="saved-name" type="text" maxlength="60" placeholder="Mercado de la semana" />
                </label>
                <button type="button" id="saved-save">Guardar</button>
                <button type="button" id="saved-share" class="ghost" style="color: #0e6a45; font-weight: 500;" hidden>📲 Compartir</button>
                <button type="button" id="saved-delete" class="ghost" hidden>Borrar</button>
              </div>
              <div id="list-collab-banner" style="margin-top: 0.5rem;" hidden></div>
            </div>
            <p id="account-status" class="account-status" role="status"></p>
          </div>

          <div id="list-rows" class="list-rows" style="position: relative;"></div>
          <div id="list-autocomplete" class="autocomplete-dropdown"></div>

          <div class="list-actions">
            <button type="button" id="add-row" class="ghost">Agregar producto</button>
            <button type="submit" id="list-submit">Comparar lista</button>
          </div>
        </div>

        <!-- Explorador de Categorías Populares -->
        <div class="categories-container" id="categories-container">
          <div class="category-chips-header">
            <span class="category-chips-title">Explorar por categorías</span>
          </div>
          <div class="category-chips-scroll" id="category-chips-scroll"></div>
          <div class="category-quick-items" id="category-quick-items" hidden></div>
        </div>

        <div class="examples" id="examples">
          <button type="button" data-query="leche entera colanta">Leche Colanta</button>
          <button type="button" data-query="arroz roa">Arroz Roa</button>
          <button type="button" data-query="aceite premier">Aceite Premier</button>
          <button type="button" data-query="televisor 55">Televisor 55"</button>
        </div>
      </form>

      <p id="status" class="status" role="status"></p>
      <section id="results" class="results" hidden></section>
      <ShareModal />
      <AddToListModal />
    </main>

    <footer>
      <p id="footnote">
        Precios de Bogotá cuando la tienda los publica para esa zona. Pueden cambiar según la sede y las promociones.
        Confirma el valor antes de pagar.
      </p>
      <div class="legal-footer-links" style="margin-top: 1.25rem;">
        <a href="/">Comparador</a>
        <span>·</span>
        <a href="/privacidad">Política de Privacidad</a>
        <span>·</span>
        <a href="/terminos">Términos y Condiciones</a>
        <span>·</span>
        <a href="mailto:soporte@mercadolista.com">Contacto</a>
      </div>
      <p style="font-size: 0.8rem; color: var(--muted); margin-top: 0.5rem; text-align: center;">© 2026 Mercado Lista · Todos los derechos reservados.</p>
    </footer>

    <CookieBanner />
    <AssistantChatWidget />

    <script src="../scripts/app.ts"></script>

    <style>
      .home-cats {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        scrollbar-width: none;
        padding: 0.5rem 0 0.75rem;
        margin-top: 0.25rem;
      }
      .home-cats::-webkit-scrollbar { display: none; }
      .home-cat-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.3rem 0.75rem;
        border: 1px solid var(--line, #e3d9c8);
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 500;
        text-decoration: none;
        color: var(--ink, #1d1a16);
        white-space: nowrap;
        flex-shrink: 0;
        transition: background 0.12s, border-color 0.12s, color 0.12s;
      }
      .home-cat-chip:hover {
        background: var(--stamp, #e7f6ee);
        border-color: var(--pine, #0e6a45);
        color: var(--pine, #0e6a45);
      }
    </style>
  </body>
</html>
