---
import '../styles/styles.css';
import ShareModal from '../components/ShareModal.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi Perfil · Mercado Lista</title>
    <meta name="description" content="Gestiona tus listas de compras guardadas y compartidas en Mercado Lista." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://mercadolista.com/perfil" />
    <meta property="og:title" content="Mi Perfil · Mercado Lista" />
    <meta property="og:description" content="Gestiona tus listas de compras guardadas y compartidas en Mercado Lista." />
    <meta property="og:url" content="https://mercadolista.com/perfil" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0e6a45" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mercado Lista" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top">
      <div class="top-bar">
        <a href="/" class="eyebrow" style="text-decoration: none;">← Volver al comparador</a>
      </div>
      <h1>Mi Perfil</h1>
      <p class="lead">Administra tu cuenta y tus listas de compras guardadas en la nube.</p>
    </header>

    <main>
      <!-- Estado No Autenticado -->
      <section id="auth-gate" class="profile-card" hidden>
        <p style="margin: 0 0 1rem; font-size: 1.1rem; color: var(--muted);">
          Inicia sesión para ver y administrar tus listas de compras guardadas.
        </p>
        <button
          type="button"
          id="profile-login-btn"
          class="auth-btn"
          style="padding: 0.6rem 1.2rem; font-size: 0.95rem;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
            ></path>
          </svg>
          Iniciar sesión con Google
        </button>
      </section>

      <!-- Estado Autenticado -->
      <section id="user-profile" class="profile-card" hidden>
        <div class="profile-header">
          <div class="profile-user-info">
            <h2 id="user-display-name">Usuario</h2>
            <p id="user-email">correo@ejemplo.com</p>
          </div>
          <button type="button" id="profile-logout-btn" class="logout-btn" style="padding: 0.5rem 1rem; border: 1px solid var(--line);">
            Cerrar sesión
          </button>
        </div>
      </section>

      <!-- Navegación de Pestañas de Perfil -->
      <div id="profile-tabs-nav" class="profile-tabs" hidden>
        <button type="button" id="tab-btn-lists" class="profile-tab-btn is-active">
          📋 Mis Listas Guardadas
        </button>
        <button type="button" id="tab-btn-shopping" class="profile-tab-btn">
          🛒 Modo Compra (En el Súper)
        </button>
      </div>

      <!-- Vista 1: Listas Guardadas -->
      <section id="lists-section" hidden>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h2 style="margin: 0; font-size: 1.4rem;">Mis Listas</h2>
          <a href="/?tab=list" class="btn-primary">+ Nueva lista</a>
        </div>

        <p id="lists-status" class="status" role="status"></p>
        <div id="lists-grid" class="profile-lists-grid"></div>
      </section>

      <!-- Vista 2: Modo Compra (En el Súper) -->
      <section id="shopping-section" class="shopping-view-card" hidden>
        <div class="shopping-selector-bar">
          <div class="shopping-selector-group">
            <label for="shopping-list-select" class="shopping-selector-label">🛒 Lista para comprar:</label>
            <select id="shopping-list-select" class="shopping-select-dropdown"></select>
          </div>
          <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <button type="button" id="shopping-compare-btn" class="btn-primary" style="background: #4a5568;" title="Comparar precios en tiendas">
              Comparar precios
            </button>
            <button type="button" id="shopping-reset-btn" class="btn-reset-checklist" title="Seguro para desmarcar toda la lista">
              🔒 Desmarcar todo
            </button>
          </div>
        </div>

        <div id="shopping-progress-panel">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; font-size: 0.92rem; font-weight: 600;">
            <span id="shopping-progress-text">0 de 0 en el carrito (0%)</span>
            <span id="shopping-live-badge" style="font-size: 0.75rem; color: #0e6a45; background: #e7f6ee; padding: 0.15rem 0.45rem; border-radius: 999px;">● Sincronización en vivo</span>
          </div>
          <div class="super-progress-bar">
            <div id="shopping-progress-fill" class="super-progress-fill" style="width: 0%;"></div>
          </div>
        </div>

        <div id="shopping-items-container" class="shopping-items-list"></div>
      </section>

      <ShareModal />
    </main>

    <footer>
      <p id="footnote">Comparador de precios · Tus datos están protegidos y sincronizados con Firebase.</p>
    </footer>

    <script>
      import {
        loginWithGoogle,
        logoutUser,
        subscribeAuth,
        getUserLists,
        subscribeUserLists,
        deleteUserList,
        subscribeList,
        toggleItemBought,
        type SavedList,
      } from '../lib/firebaseAuth';
      import { initShareModal } from '../scripts/shareModal';

      const authGate = document.querySelector<HTMLElement>('#auth-gate')!;
      const userProfile = document.querySelector<HTMLElement>('#user-profile')!;
      const userDisplayName = document.querySelector<HTMLElement>('#user-display-name')!;
      const userEmail = document.querySelector<HTMLElement>('#user-email')!;
      const profileLoginBtn = document.querySelector<HTMLButtonElement>('#profile-login-btn')!;
      const profileLogoutBtn = document.querySelector<HTMLButtonElement>('#profile-logout-btn')!;

      const profileTabsNav = document.querySelector<HTMLElement>('#profile-tabs-nav')!;
      const tabBtnLists = document.querySelector<HTMLButtonElement>('#tab-btn-lists')!;
      const tabBtnShopping = document.querySelector<HTMLButtonElement>('#tab-btn-shopping')!;

      const listsSection = document.querySelector<HTMLElement>('#lists-section')!;
      const listsGrid = document.querySelector<HTMLElement>('#lists-grid')!;
      const listsStatus = document.querySelector<HTMLElement>('#lists-status')!;

      const shoppingSection = document.querySelector<HTMLElement>('#shopping-section')!;
      const shoppingListSelect = document.querySelector<HTMLSelectElement>('#shopping-list-select')!;
      const shoppingCompareBtn = document.querySelector<HTMLButtonElement>('#shopping-compare-btn')!;
      const shoppingResetBtn = document.querySelector<HTMLButtonElement>('#shopping-reset-btn')!;
      const shoppingProgressText = document.querySelector<HTMLElement>('#shopping-progress-text')!;
      const shoppingProgressFill = document.querySelector<HTMLElement>('#shopping-progress-fill')!;
      const shoppingItemsContainer = document.querySelector<HTMLElement>('#shopping-items-container')!;

      const openShareModal = initShareModal();

      let currentUid: string | null = null;
      let currentUserEmail: string | null = null;
      let cachedLists: SavedList[] = [];
      let activeShoppingList: SavedList | null = null;
      let unsubscribeShoppingLive: (() => void) | null = null;
      let unsubscribeUserListsLive: (() => void) | null = null;

      function setProfileTab(tab: 'lists' | 'shopping') {
        const isLists = tab === 'lists';
        tabBtnLists.classList.toggle('is-active', isLists);
        tabBtnShopping.classList.toggle('is-active', !isLists);
        listsSection.hidden = !isLists;
        shoppingSection.hidden = isLists;

        if (!isLists && cachedLists.length > 0 && !activeShoppingList) {
          selectShoppingList(cachedLists[0].id);
        }
      }

      tabBtnLists.addEventListener('click', () => setProfileTab('lists'));
      tabBtnShopping.addEventListener('click', () => setProfileTab('shopping'));

      function renderLists(lists: SavedList[]) {
        listsGrid.replaceChildren();

        if (lists.length === 0) {
          listsGrid.innerHTML = `
            <div class="panel" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
              <p style="margin: 0 0 1rem; color: var(--muted);">Aún no tienes listas guardadas.</p>
              <a href="/?tab=list" class="btn-primary" style="display: inline-flex;">Crear mi primera lista</a>
            </div>
          `;
          return;
        }

        lists.forEach((list) => {
          const card = document.createElement('article');
          card.className = 'saved-list-card';

          const otherCollabs: string[] = [];
          if (list.collaborators && list.collaborators.length > 0) {
            list.collaborators.forEach((c) => {
              if (c.uid !== currentUid && (c.name || c.email)) {
                otherCollabs.push(c.name || (c.email ? c.email.split('@')[0] : 'Colaborador'));
              }
            });
          }
          if (list.sharedWithEmails && list.sharedWithEmails.length > 0) {
            list.sharedWithEmails.forEach((email) => {
              const short = email.split('@')[0];
              if (email !== currentUserEmail && !otherCollabs.includes(short)) {
                otherCollabs.push(short);
              }
            });
          }

          const uniqueCollabs = [...new Set(otherCollabs)];

          let collabBadge = '';
          if (list.isOwner) {
            if (uniqueCollabs.length > 0) {
              collabBadge = `<span class="collab-badge">👥 Compartida con: <strong>${uniqueCollabs.join(', ')}</strong></span>`;
            } else {
              collabBadge = `<span style="display: inline-block; font-size: 0.72rem; color: var(--muted); margin-bottom: 0.35rem;">🔒 Solo tú</span>`;
            }
          } else {
            const ownerDisplayName = list.ownerName || (list.ownerEmail ? list.ownerEmail.split('@')[0] : 'tu pareja');
            const others = uniqueCollabs.filter((n) => n !== ownerDisplayName);
            collabBadge = `<span class="collab-badge">👥 Compartida por <strong>${ownerDisplayName}</strong>${others.length > 0 ? ` (y ${others.join(', ')})` : ''}</span>`;
          }

          const itemsText = list.items
            .slice(0, 4)
            .map((i) => {
              const isMe = currentUid && i.addedById === currentUid;
              const author = isMe ? ' <span style="color: #0e6a45; font-size: 0.75rem;">(por ti)</span>' : (i.addedBy ? ` <span style="color: #0e6a45; font-size: 0.75rem;">(por ${i.addedBy})</span>` : '');
              return `${i.nombre} (${i.cantidad} ${i.formato})${author}`;
            })
            .join(', ');
          const extraCount = list.items.length > 4 ? ` y ${list.items.length - 4} más…` : '';

          const boughtCount = list.items.filter((i) => i.comprado).length;
          const boughtBadge = boughtCount > 0
            ? `<span style="display: inline-block; font-size: 0.72rem; color: #0e6a45; background: #e7f6ee; padding: 0.15rem 0.45rem; border-radius: 4px; margin-left: 0.35rem; font-weight: 600;">✓ ${boughtCount}/${list.items.length} en carrito</span>`
            : '';

          card.innerHTML = `
            <div>
              ${collabBadge}
              <div class="saved-list-header">
                <h3 class="saved-list-title">${list.nombre}</h3>
                <span class="saved-list-city">${list.ciudad || 'Bogotá'}</span>
              </div>
              <p class="saved-list-items-preview">
                <strong>${list.items.length} producto${list.items.length === 1 ? '' : 's'}:</strong>${boughtBadge}<br />
                ${itemsText}${extraCount}
              </p>
            </div>
            <div class="saved-list-actions" style="flex-wrap: wrap; gap: 0.4rem;">
              <button type="button" class="btn-primary shop-mode-btn" style="background: #0e6a45; font-weight: 600;" title="Abrir checklist de compra para ir tachando en el súper">
                🛒 Modo Compra
              </button>
              <button type="button" class="btn-primary compare-btn" style="background: #4a5568;" title="Comparar precios en tiendas">
                Comparar precios
              </button>
              <button type="button" class="btn-primary share-btn" style="background: #128c7e;" title="Compartir lista con tu pareja por WhatsApp o Correo">
                📲 Compartir
              </button>
              <button type="button" class="btn-danger-ghost delete-btn">
                ${list.isOwner ? 'Borrar' : 'Desvincularme'}
              </button>
            </div>
          `;

          // Botón Modo Compra
          card.querySelector('.shop-mode-btn')!.addEventListener('click', () => {
            selectShoppingList(list.id);
            setProfileTab('shopping');
          });

          // Botón Comparar
          card.querySelector('.compare-btn')!.addEventListener('click', () => {
            localStorage.setItem('comparador-lista', JSON.stringify(list.items));
            if (list.ciudad) {
              localStorage.setItem('comparador-ciudad', list.ciudad);
            }
            window.location.href = `/?tab=list&listaId=${list.id}`;
          });

          // Botón Compartir
          card.querySelector('.share-btn')!.addEventListener('click', () => {
            openShareModal({ listId: list.id, listName: list.nombre });
          });

          // Botón Eliminar con seguro de confirmación
          card.querySelector('.delete-btn')!.addEventListener('click', async () => {
            const accion = list.isOwner ? 'eliminar' : 'desvincularte de';
            if (!currentUid || !window.confirm(`¿Deseas ${accion} la lista «${list.nombre}»?`)) return;
            try {
              await deleteUserList(currentUid, list.id, list.isOwner);
              loadLists(currentUid, currentUserEmail);
            } catch (err: any) {
              alert(err.message || 'Error al eliminar la lista');
            }
          });

          listsGrid.append(card);
        });
      }

      function updateShoppingDropdown() {
        shoppingListSelect.replaceChildren();
        if (cachedLists.length === 0) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'No tienes listas creadas';
          shoppingListSelect.append(opt);
          return;
        }

        cachedLists.forEach((l) => {
          const opt = document.createElement('option');
          opt.value = l.id;
          opt.textContent = `${l.nombre} (${l.items.length} productos)`;
          shoppingListSelect.append(opt);
        });

        if (activeShoppingList) {
          shoppingListSelect.value = activeShoppingList.id;
        }
      }

      function selectShoppingList(listId: string) {
        const found = cachedLists.find((l) => l.id === listId);
        if (!found) return;
        activeShoppingList = found;
        shoppingListSelect.value = listId;

        renderShoppingChecklist(found);

        // Suscripción en tiempo real a los cambios de la lista
        if (unsubscribeShoppingLive) unsubscribeShoppingLive();
        unsubscribeShoppingLive = subscribeList(listId, (updated) => {
          if (!updated) return;
          const idx = cachedLists.findIndex((l) => l.id === listId);
          if (idx !== -1) cachedLists[idx] = updated;
          activeShoppingList = updated;
          renderShoppingChecklist(updated);
        });
      }

      function renderShoppingChecklist(list: SavedList) {
        shoppingItemsContainer.replaceChildren();

        const total = list.items.length;
        const bought = list.items.filter((i) => i.comprado).length;
        const pct = total > 0 ? Math.round((bought / total) * 100) : 0;

        shoppingProgressText.textContent = `${bought} de ${total} en el carrito (${pct}%)`;
        shoppingProgressFill.style.width = `${pct}%`;

        if (total === 0) {
          shoppingItemsContainer.innerHTML = `
            <div style="text-align: center; color: var(--muted); padding: 2rem;">
              <p>Esta lista no tiene productos agregados todavía.</p>
              <a href="/?tab=list&listaId=${list.id}" class="btn-primary" style="display: inline-flex;">Editar productos</a>
            </div>
          `;
          return;
        }

        list.items.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = `shopping-item-row ${item.comprado ? 'is-bought' : ''}`;
          row.setAttribute('role', 'checkbox');
          row.setAttribute('aria-checked', item.comprado ? 'true' : 'false');
          row.setAttribute('tabindex', '0');

          const isMe = currentUid && item.addedById === currentUid;
          const authorName = isMe ? 'Tú' : (item.addedBy || '');
          const authorBadge = authorName
            ? `<span class="shopping-item-author">👤 ${authorName}</span>`
            : '';

          row.innerHTML = `
            <div class="shopping-item-check"></div>
            <div class="shopping-item-info">
              <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0.35rem;">
                <h4 class="shopping-item-name" style="margin: 0;">${item.nombre}</h4>
                ${authorBadge}
              </div>
              <p class="shopping-item-meta" style="margin-top: 0.2rem;">
                <strong>${item.cantidad} ${item.formato}</strong>
                ${item.marca && item.marca.toUpperCase() !== 'TODAS' ? `· Marca: ${item.marca}` : ''}
              </p>
            </div>
          `;

          async function toggleThisItem() {
            const nextBought = !item.comprado;
            item.comprado = nextBought;
            row.classList.toggle('is-bought', nextBought);
            row.setAttribute('aria-checked', nextBought ? 'true' : 'false');

            const newBought = list.items.filter((i) => i.comprado).length;
            const newPct = total > 0 ? Math.round((newBought / total) * 100) : 0;
            shoppingProgressText.textContent = `${newBought} de ${total} en el carrito (${newPct}%)`;
            shoppingProgressFill.style.width = `${newPct}%`;

            try {
              await toggleItemBought(list.id, index, nextBought);
            } catch (err) {
              console.error('Error al actualizar item:', err);
            }
          }

          row.addEventListener('click', toggleThisItem);
          row.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'Enter') {
              e.preventDefault();
              toggleThisItem();
            }
          });

          shoppingItemsContainer.append(row);
        });
      }

      shoppingListSelect.addEventListener('change', () => {
        selectShoppingList(shoppingListSelect.value);
      });

      shoppingCompareBtn.addEventListener('click', () => {
        if (!activeShoppingList) return;
        localStorage.setItem('comparador-lista', JSON.stringify(activeShoppingList.items));
        if (activeShoppingList.ciudad) {
          localStorage.setItem('comparador-ciudad', activeShoppingList.ciudad);
        }
        window.location.href = `/?tab=list&listaId=${activeShoppingList.id}`;
      });

      // Seguro para desmarcar: Confirmación obligatoria para evitar accidentes
      shoppingResetBtn.addEventListener('click', async () => {
        if (!activeShoppingList) return;
        const confirmReset = window.confirm(
          `🔒 ¿Seguro que deseas desmarcar todos los productos de «${activeShoppingList.nombre}» para empezar una nueva compra?`
        );
        if (!confirmReset) return;

        shoppingResetBtn.disabled = true;
        shoppingResetBtn.textContent = 'Desmarcando…';
        try {
          for (let i = 0; i < activeShoppingList.items.length; i++) {
            if (activeShoppingList.items[i].comprado) {
              activeShoppingList.items[i].comprado = false;
              await toggleItemBought(activeShoppingList.id, i, false);
            }
          }
          renderShoppingChecklist(activeShoppingList);
        } finally {
          shoppingResetBtn.disabled = false;
          shoppingResetBtn.textContent = '🔒 Desmarcar todo';
        }
      });

      async function loadLists(uid: string, email?: string | null) {
        listsStatus.textContent = 'Cargando tus listas…';
        try {
          const lists = await getUserLists(uid, email);
          cachedLists = lists;
          listsStatus.textContent = '';
          renderLists(lists);
          updateShoppingDropdown();

          // Revisar si viene con parámetro de modo compra
          const urlParams = new URLSearchParams(window.location.search);
          const paramListId = urlParams.get('listaId');
          const isShoppingMode = urlParams.get('modo') === 'compra' || !!paramListId;

          if (isShoppingMode && lists.length > 0) {
            const targetId = paramListId && lists.some((l) => l.id === paramListId) ? paramListId : lists[0].id;
            selectShoppingList(targetId);
            setProfileTab('shopping');
          }
        } catch (err: any) {
          listsStatus.textContent = 'No se pudieron cargar las listas.';
        }
      }

      profileLoginBtn.addEventListener('click', async () => {
        try {
          await loginWithGoogle();
        } catch (err: any) {
          console.error('Error al iniciar sesión con Google:', err);
          let msg = err.message || 'Error al iniciar sesión';
          if (err.code === 'auth/unauthorized-domain') {
            msg = `El dominio «${window.location.hostname}» no está autorizado en Firebase. Agrégalo en Firebase Console > Authentication > Settings > Authorized domains.`;
          } else if (err.code === 'auth/popup-blocked') {
            msg = 'Tu navegador bloqueó la ventana emergente de Google. Por favor habilita los popups para este sitio.';
          } else if (err.code === 'auth/popup-closed-by-user') {
            msg = 'Se cerró la ventana emergente antes de completar el inicio de sesión.';
          }
          alert(msg);
        }
      });

      profileLogoutBtn.addEventListener('click', async () => {
        if (unsubscribeShoppingLive) unsubscribeShoppingLive();
        if (unsubscribeUserListsLive) unsubscribeUserListsLive();
        await logoutUser();
        window.location.href = '/';
      });

      subscribeAuth((user) => {
        if (user) {
          currentUid = user.uid;
          currentUserEmail = user.email || null;
          authGate.hidden = true;
          userProfile.hidden = false;
          profileTabsNav.hidden = false;
          listsSection.hidden = false;

          userDisplayName.textContent = user.displayName || 'Usuario';
          userEmail.textContent = user.email || '';

          if (unsubscribeUserListsLive) unsubscribeUserListsLive();
          unsubscribeUserListsLive = subscribeUserLists(user.uid, currentUserEmail, (liveLists) => {
            cachedLists = liveLists;
            listsStatus.textContent = '';
            renderLists(liveLists);
            updateShoppingDropdown();
          });

          loadLists(user.uid, currentUserEmail);
        } else {
          currentUid = null;
          currentUserEmail = null;
          if (unsubscribeShoppingLive) unsubscribeShoppingLive();
          if (unsubscribeUserListsLive) unsubscribeUserListsLive();
          authGate.hidden = false;
          userProfile.hidden = true;
          profileTabsNav.hidden = true;
          listsSection.hidden = true;
          shoppingSection.hidden = true;
        }
      });
    </script>
  </body>
</html>
