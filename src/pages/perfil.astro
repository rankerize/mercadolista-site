---
import '../styles/styles.css';
import Nav from '../components/Nav.astro';
import ShareModal from '../components/ShareModal.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import AssistantChatWidget from '../components/AssistantChatWidget.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi Perfil · Mercado Lista</title>
    <meta name="description" content="Gestiona tus listas de compras guardadas y compartidas en Mercado Lista." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://mercadolista.com/perfil" />
    <meta property="og:title" content="Mi Perfil · Mercado Lista" />
    <meta property="og:description" content="Gestiona tus listas de compras guardadas y compartidas en Mercado Lista." />
    <meta property="og:url" content="https://mercadolista.com/perfil" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0e6a45" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mercado Lista" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <header class="top">
      <div class="top-bar">
        <a href="/" class="brand-header" title="Mercado Lista · Inicio">
          <img src="/logo.png" alt="Mercado Lista" class="brand-logo-img" width="34" height="34" />
          <span class="brand-name">Mercado Lista</span>
        </a>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
          <a href="/asistente" style="text-decoration: none; font-size: 0.85rem; color: #0e6a45; font-weight: 600; background: #e7f6ee; padding: 0.3rem 0.65rem; border-radius: 999px; border: 1px solid #a7f3d0;" title="Asistente de compras y recetas con IA">
            🧑‍🍳 Asistente IA
          </a>
          <a href="/" style="text-decoration: none; font-size: 0.85rem; color: var(--pine); font-weight: 500;">← Volver al comparador</a>
        </div>
      </div>
      <h1>Mi Perfil</h1>
      <p class="lead">Administra tu cuenta y tus listas de compras guardadas en la nube.</p>
    </header>

    <main>
      <!-- Estado No Autenticado -->
      <section id="auth-gate" class="profile-card" hidden>
        <p style="margin: 0 0 1rem; font-size: 1.1rem; color: var(--muted);">
          Inicia sesión para ver y administrar tus listas de compras guardadas.
        </p>
        <button
          type="button"
          id="profile-login-btn"
          class="auth-btn"
          style="padding: 0.6rem 1.2rem; font-size: 0.95rem;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
            ></path>
          </svg>
          Iniciar sesión con Google
        </button>
      </section>

      <!-- Estado Autenticado -->
      <section id="user-profile" class="profile-card" hidden>
        <div class="profile-header">
          <div class="profile-user-info">
            <h2 id="user-display-name">Usuario</h2>
            <p id="user-email">correo@ejemplo.com</p>
            <div id="user-quick-meta" class="user-quick-meta" style="margin-top: 0.45rem; display: flex; gap: 0.5rem; flex-wrap: wrap;"></div>
          </div>
          <button type="button" id="profile-logout-btn" class="logout-btn" style="padding: 0.5rem 1rem; border: 1px solid var(--line);">
            Cerrar sesión
          </button>
        </div>
      </section>

      <!-- Navegación de Pestañas de Perfil -->
      <div id="profile-tabs-nav" class="profile-tabs" hidden>
        <button type="button" id="tab-btn-lists" class="profile-tab-btn is-active">
          📋 Mis Listas Guardadas
        </button>
        <button type="button" id="tab-btn-shopping" class="profile-tab-btn">
          🛒 Modo Compra (En el Súper)
        </button>
        <button type="button" id="tab-btn-data" class="profile-tab-btn">
          📍 Mis Direcciones y Contacto
        </button>
      </div>

      <!-- Vista 1: Listas Guardadas -->
      <section id="lists-section" hidden>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
          <h2 style="margin: 0; font-size: 1.4rem;">Mis Listas</h2>
          <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <a href="/asistente" class="btn-primary" style="background: linear-gradient(135deg, #0e6a45, #15803d);">🧑‍🍳 Crear con Asistente IA</a>
            <a href="/?tab=list" class="btn-primary">+ Nueva lista vacía</a>
          </div>
        </div>

        <div class="list-filter-bar" id="list-filter-bar">
          <button type="button" class="list-filter-chip is-active" data-filter="all">Todas (<span id="count-all">0</span>)</button>
          <button type="button" class="list-filter-chip" data-filter="mercado">🛒 Mercados (<span id="count-mercado">0</span>)</button>
          <button type="button" class="list-filter-chip" data-filter="receta">🍳 Recetas (<span id="count-receta">0</span>)</button>
        </div>

        <p id="lists-status" class="status" role="status"></p>
        <div id="lists-grid" class="profile-lists-grid"></div>
      </section>

      <!-- Vista 2: Modo Compra (En el Súper) -->
      <section id="shopping-section" class="shopping-view-card" hidden>
        <div class="shopping-selector-bar">
          <div class="shopping-selector-group">
            <label for="shopping-list-select" class="shopping-selector-label">🛒 Lista para comprar:</label>
            <select id="shopping-list-select" class="shopping-select-dropdown"></select>
          </div>
          <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <button type="button" id="shopping-compare-btn" class="btn-primary" style="background: #4a5568;" title="Comparar precios en tiendas">
              Comparar precios
            </button>
            <button type="button" id="shopping-reset-btn" class="btn-reset-checklist" title="Seguro para desmarcar toda la lista">
              🔒 Desmarcar todo
            </button>
          </div>
        </div>

        <div id="shopping-progress-panel">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; font-size: 0.92rem; font-weight: 600;">
            <span id="shopping-progress-text">0 de 0 en el carrito (0%)</span>
            <span id="shopping-live-badge" style="font-size: 0.75rem; color: #0e6a45; background: #e7f6ee; padding: 0.15rem 0.45rem; border-radius: 999px;">● Sincronización en vivo</span>
          </div>
          <div class="super-progress-bar">
            <div id="shopping-progress-fill" class="super-progress-fill" style="width: 0%;"></div>
          </div>
        </div>

        <div id="shopping-items-container" class="shopping-items-list"></div>
      </section>

      <!-- Vista 3: Mis Direcciones y Datos de Contacto -->
      <section id="data-section" class="profile-card" hidden>
        <div class="profile-section-header" style="margin-bottom: 1.25rem;">
          <h2 style="margin: 0 0 0.35rem; font-size: 1.35rem; color: var(--pine-deep);">📍 Mis Direcciones y Datos de Contacto</h2>
          <p style="margin: 0; color: var(--muted); font-size: 0.9rem;">
            Configura tu ubicación principal, dirección secundaria y teléfono. Estos datos nos permitirán a futuro calcular las tiendas más cercanas a tu casa o trabajo y optimizar tus rutas de compra.
          </p>
        </div>

        <form id="profile-data-form" class="profile-data-form">
          <div class="profile-form-grid">
            <!-- Nombre de contacto -->
            <div class="profile-form-group">
              <label for="profile-input-name" class="profile-form-label">
                👤 Nombre de contacto
              </label>
              <input
                type="text"
                id="profile-input-name"
                class="profile-form-input"
                placeholder="Tu nombre completo"
                autocomplete="name"
              />
            </div>

            <!-- Teléfono / WhatsApp -->
            <div class="profile-form-group">
              <label for="profile-input-phone" class="profile-form-label">
                📱 Teléfono / WhatsApp
              </label>
              <input
                type="tel"
                id="profile-input-phone"
                class="profile-form-input"
                placeholder="Ej: 310 123 4567"
                autocomplete="tel"
              />
              <span class="profile-form-hint">Para soporte, coordinación y alertas de precios.</span>
            </div>

            <!-- Ciudad Principal -->
            <div class="profile-form-group profile-form-group-full">
              <label for="profile-select-city" class="profile-form-label">
                🏙️ Ciudad principal (para comparar precios)
              </label>
              <select id="profile-select-city" class="profile-form-select"></select>
              <span class="profile-form-hint">Esta ciudad se seleccionará automáticamente en tus búsquedas de precios.</span>
            </div>

            <!-- Dirección Principal -->
            <div class="profile-form-group profile-form-group-full">
              <label for="profile-input-address-main" class="profile-form-label">
                🏠 Dirección principal (Casa / Residencia)
              </label>
              <div class="profile-address-row">
                <input
                  type="text"
                  id="profile-input-address-main"
                  class="profile-form-input"
                  placeholder="Dirección (Ej: Cra 15 # 85-30 Apto 402)"
                  autocomplete="street-address"
                />
                <input
                  type="text"
                  id="profile-input-neighborhood-main"
                  class="profile-form-input"
                  placeholder="Barrio (Ej: Chicó Norte)"
                />
              </div>
              <span class="profile-form-hint">Tu punto de partida para supermercados cercanos (Éxito, Jumbo, D1, Carulla, Olímpica).</span>
            </div>

            <!-- Dirección Secundaria -->
            <div class="profile-form-group profile-form-group-full">
              <label for="profile-input-address-sec" class="profile-form-label">
                🏢 Dirección secundaria (Trabajo / Familiar / Otra) <span style="font-weight: 400; color: var(--muted);">(Opcional)</span>
              </label>
              <div class="profile-address-row">
                <input
                  type="text"
                  id="profile-input-address-sec"
                  class="profile-form-input"
                  placeholder="Dirección (Ej: Cl. 100 # 19-61 Torre B)"
                />
                <input
                  type="text"
                  id="profile-input-neighborhood-sec"
                  class="profile-form-input"
                  placeholder="Barrio (Ej: Santa Bárbara)"
                />
              </div>
            </div>

            <!-- Notas de ubicación / Puntos de referencia -->
            <div class="profile-form-group profile-form-group-full">
              <label for="profile-input-notes" class="profile-form-label">
                📌 Punto de referencia o notas
              </label>
              <textarea
                id="profile-input-notes"
                class="profile-form-textarea"
                rows="2"
                placeholder="Ej: Frente al parque, conjunto cerrado torre 3, portería peatonal..."
              ></textarea>
            </div>
          </div>

          <div class="profile-form-actions">
            <button type="submit" id="profile-save-btn" class="btn-primary" style="padding: 0.65rem 1.75rem; font-size: 0.95rem;">
              💾 Guardar datos
            </button>
            <span id="profile-save-status" class="profile-save-status" role="status" aria-live="polite"></span>
          </div>
        </form>
      </section>

      <ShareModal />
      <AssistantChatWidget />
    </main>

    <footer>
      <p id="footnote">Comparador de precios · Tus datos están protegidos y sincronizados con Firebase.</p>
    </footer>

    <script>
      import {
        loginWithGoogle,
        logoutUser,
        subscribeAuth,
        getUserLists,
        subscribeUserLists,
        deleteUserList,
        subscribeList,
        toggleItemBought,
        getUserProfile,
        saveUserProfile,
        type SavedList,
        type UserProfileData,
      } from '../lib/firebaseAuth';
      import { CITIES } from '../lib/cities';
      import { initShareModal } from '../scripts/shareModal';
      import { escapeHtml } from '../lib/normalize';

      const authGate = document.querySelector<HTMLElement>('#auth-gate')!;
      const userProfile = document.querySelector<HTMLElement>('#user-profile')!;
      const userDisplayName = document.querySelector<HTMLElement>('#user-display-name')!;
      const userEmail = document.querySelector<HTMLElement>('#user-email')!;
      const userQuickMeta = document.querySelector<HTMLElement>('#user-quick-meta')!;
      const profileLoginBtn = document.querySelector<HTMLButtonElement>('#profile-login-btn')!;
      const profileLogoutBtn = document.querySelector<HTMLButtonElement>('#profile-logout-btn')!;

      const profileTabsNav = document.querySelector<HTMLElement>('#profile-tabs-nav')!;
      const tabBtnLists = document.querySelector<HTMLButtonElement>('#tab-btn-lists')!;
      const tabBtnShopping = document.querySelector<HTMLButtonElement>('#tab-btn-shopping')!;
      const tabBtnData = document.querySelector<HTMLButtonElement>('#tab-btn-data')!;

      const listsSection = document.querySelector<HTMLElement>('#lists-section')!;
      const listsGrid = document.querySelector<HTMLElement>('#lists-grid')!;
      const listsStatus = document.querySelector<HTMLElement>('#lists-status')!;

      const shoppingSection = document.querySelector<HTMLElement>('#shopping-section')!;
      const shoppingListSelect = document.querySelector<HTMLSelectElement>('#shopping-list-select')!;
      const shoppingCompareBtn = document.querySelector<HTMLButtonElement>('#shopping-compare-btn')!;
      const shoppingResetBtn = document.querySelector<HTMLButtonElement>('#shopping-reset-btn')!;
      const shoppingProgressText = document.querySelector<HTMLElement>('#shopping-progress-text')!;
      const shoppingProgressFill = document.querySelector<HTMLElement>('#shopping-progress-fill')!;
      const shoppingItemsContainer = document.querySelector<HTMLElement>('#shopping-items-container')!;

      const dataSection = document.querySelector<HTMLElement>('#data-section')!;
      const profileDataForm = document.querySelector<HTMLFormElement>('#profile-data-form')!;
      const profileInputName = document.querySelector<HTMLInputElement>('#profile-input-name')!;
      const profileInputPhone = document.querySelector<HTMLInputElement>('#profile-input-phone')!;
      const profileSelectCity = document.querySelector<HTMLSelectElement>('#profile-select-city')!;
      const profileInputAddressMain = document.querySelector<HTMLInputElement>('#profile-input-address-main')!;
      const profileInputNeighborhoodMain = document.querySelector<HTMLInputElement>('#profile-input-neighborhood-main')!;
      const profileInputAddressSec = document.querySelector<HTMLInputElement>('#profile-input-address-sec')!;
      const profileInputNeighborhoodSec = document.querySelector<HTMLInputElement>('#profile-input-neighborhood-sec')!;
      const profileInputNotes = document.querySelector<HTMLTextAreaElement>('#profile-input-notes')!;
      const profileSaveBtn = document.querySelector<HTMLButtonElement>('#profile-save-btn')!;
      const profileSaveStatus = document.querySelector<HTMLElement>('#profile-save-status')!;

      const openShareModal = initShareModal();

      let currentUid: string | null = null;
      let currentUserEmail: string | null = null;
      let cachedLists: SavedList[] = [];
      let activeShoppingList: SavedList | null = null;
      let unsubscribeShoppingLive: (() => void) | null = null;
      let unsubscribeUserListsLive: (() => void) | null = null;

      // Inicializar selector de ciudades en el formulario de datos
      CITIES.forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        profileSelectCity.append(opt);
      });

      function setProfileTab(tab: 'lists' | 'shopping' | 'data') {
        tabBtnLists.classList.toggle('is-active', tab === 'lists');
        tabBtnShopping.classList.toggle('is-active', tab === 'shopping');
        tabBtnData.classList.toggle('is-active', tab === 'data');
        listsSection.hidden = tab !== 'lists';
        shoppingSection.hidden = tab !== 'shopping';
        dataSection.hidden = tab !== 'data';

        if (tab === 'shopping' && cachedLists.length > 0 && !activeShoppingList) {
          selectShoppingList(cachedLists[0].id);
        }
      }

      tabBtnLists.addEventListener('click', () => setProfileTab('lists'));
      tabBtnShopping.addEventListener('click', () => setProfileTab('shopping'));
      tabBtnData.addEventListener('click', () => setProfileTab('data'));

      let currentListFilter: 'all' | 'mercado' | 'receta' = 'all';

      // Configurar chips de filtro (Todas, Mercados, Recetas)
      const filterChips = document.querySelectorAll<HTMLButtonElement>('.list-filter-chip');
      filterChips.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterChips.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          currentListFilter = (btn.dataset.filter || 'all') as any;
          renderLists(cachedLists);
        });
      });

      function renderLists(lists: SavedList[]) {
        listsGrid.replaceChildren();

        const countAllEl = document.querySelector('#count-all');
        const countMercadoEl = document.querySelector('#count-mercado');
        const countRecetaEl = document.querySelector('#count-receta');
        if (countAllEl) countAllEl.textContent = String(cachedLists.length);
        if (countMercadoEl) countMercadoEl.textContent = String(cachedLists.filter((l) => (l.tipo || 'mercado') === 'mercado').length);
        if (countRecetaEl) countRecetaEl.textContent = String(cachedLists.filter((l) => l.tipo === 'receta').length);

        const displayLists = lists.filter((l) => {
          if (currentListFilter === 'all') return true;
          if (currentListFilter === 'receta') return l.tipo === 'receta';
          return (l.tipo || 'mercado') === 'mercado';
        });

        if (displayLists.length === 0) {
          const emptyMsg = cachedLists.length === 0
            ? 'Aún no tienes listas guardadas.'
            : 'No tienes listas en esta categoría.';
          listsGrid.innerHTML = `
            <div class="panel" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
              <p style="margin: 0 0 1rem; color: var(--muted);">${emptyMsg}</p>
              <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
                <a href="/asistente" class="btn-primary" style="background: linear-gradient(135deg, #0e6a45, #15803d);">🧑‍🍳 Crear Receta con IA</a>
                <a href="/?tab=list" class="btn-primary">Crear lista de mercado</a>
              </div>
            </div>
          `;
          return;
        }

        displayLists.forEach((list) => {
          const card = document.createElement('article');
          card.className = 'saved-list-card';

          const otherCollabs: string[] = [];
          if (list.collaborators && list.collaborators.length > 0) {
            list.collaborators.forEach((c) => {
              if (c.uid !== currentUid && (c.name || c.email)) {
                otherCollabs.push(c.name || (c.email ? c.email.split('@')[0] : 'Colaborador'));
              }
            });
          }
          if (list.sharedWithEmails && list.sharedWithEmails.length > 0) {
            list.sharedWithEmails.forEach((email) => {
              const short = email.split('@')[0];
              if (email !== currentUserEmail && !otherCollabs.includes(short)) {
                otherCollabs.push(short);
              }
            });
          }

          const uniqueCollabs = [...new Set(otherCollabs)];

          let collabBadge = '';
          if (list.isOwner) {
            if (uniqueCollabs.length > 0) {
              const safeCollabs = uniqueCollabs.map(escapeHtml).join(', ');
              collabBadge = `<span class="collab-badge">👥 Compartida con: <strong>${safeCollabs}</strong></span>`;
            } else {
              collabBadge = `<span style="display: inline-block; font-size: 0.72rem; color: var(--muted); margin-bottom: 0.35rem;">🔒 Solo tú</span>`;
            }
          } else {
            const ownerDisplayName = list.ownerName || (list.ownerEmail ? list.ownerEmail.split('@')[0] : 'tu pareja');
            const others = uniqueCollabs.filter((n) => n !== ownerDisplayName);
            const othersText = others.length > 0 ? ` (y ${others.map(escapeHtml).join(', ')})` : '';
            collabBadge = `<span class="collab-badge">👥 Compartida por <strong>${escapeHtml(ownerDisplayName)}</strong>${othersText}</span>`;
          }

          const itemsText = list.items
            .slice(0, 4)
            .map((i) => {
              const isMe = currentUid && i.addedById === currentUid;
              const author = isMe ? ' <span style="color: #0e6a45; font-size: 0.75rem;">(por ti)</span>' : (i.addedBy ? ` <span style="color: #0e6a45; font-size: 0.75rem;">(por ${escapeHtml(i.addedBy)})</span>` : '');
              return `${escapeHtml(i.nombre)} (${Number(i.cantidad)} ${escapeHtml(i.formato)})${author}`;
            })
            .join(', ');
          const extraCount = list.items.length > 4 ? ` y ${list.items.length - 4} más…` : '';

          const boughtCount = list.items.filter((i) => i.comprado).length;
          const boughtBadge = boughtCount > 0
            ? `<span style="display: inline-block; font-size: 0.72rem; color: #0e6a45; background: #e7f6ee; padding: 0.15rem 0.45rem; border-radius: 4px; margin-left: 0.35rem; font-weight: 600;">✓ ${boughtCount}/${list.items.length} en carrito</span>`
            : '';

          const tipoBadge = list.tipo === 'receta'
            ? `<span class="badge-tipo-receta">🍳 Receta${list.porciones ? ` · ${list.porciones} pers.` : ''}</span>`
            : `<span class="badge-tipo-mercado">🛒 Mercado</span>`;

          const descHtml = list.descripcion
            ? `<p style="font-size: 0.85rem; color: #475569; margin: 0.25rem 0 0.45rem; line-height: 1.35; font-style: italic;">${escapeHtml(list.descripcion)}</p>`
            : '';

          card.innerHTML = `
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; flex-wrap: wrap; gap: 0.35rem;">
                ${collabBadge}
                ${tipoBadge}
              </div>
              <div class="saved-list-header">
                <h3 class="saved-list-title">${escapeHtml(list.nombre)}</h3>
                <span class="saved-list-city">${escapeHtml(list.ciudad || 'Bogotá')}</span>
              </div>
              ${descHtml}
              <p class="saved-list-items-preview">
                <strong>${list.items.length} producto${list.items.length === 1 ? '' : 's'}:</strong>${boughtBadge}<br />
                ${itemsText}${extraCount}
              </p>
            </div>
            <div class="saved-list-actions" style="flex-wrap: wrap; gap: 0.4rem;">
              <button type="button" class="btn-primary shop-mode-btn" style="background: #0e6a45; font-weight: 600;" title="Abrir checklist de compra para ir tachando en el súper">
                🛒 Modo Compra
              </button>
              <button type="button" class="btn-primary compare-btn" style="background: #4a5568;" title="Comparar precios en tiendas">
                Comparar precios
              </button>
              <button type="button" class="btn-primary share-btn" style="background: #128c7e;" title="Compartir lista con tu pareja por WhatsApp o Correo">
                📲 Compartir
              </button>
              <button type="button" class="btn-danger-ghost delete-btn">
                ${list.isOwner ? 'Borrar' : 'Desvincularme'}
              </button>
            </div>
          `;

          // Botón Modo Compra
          card.querySelector('.shop-mode-btn')!.addEventListener('click', () => {
            selectShoppingList(list.id);
            setProfileTab('shopping');
          });

          // Botón Comparar
          card.querySelector('.compare-btn')!.addEventListener('click', () => {
            localStorage.setItem('comparador-lista', JSON.stringify(list.items));
            if (list.ciudad) {
              localStorage.setItem('comparador-ciudad', list.ciudad);
            }
            window.location.href = `/?tab=list&listaId=${list.id}`;
          });

          // Botón Compartir
          card.querySelector('.share-btn')!.addEventListener('click', () => {
            openShareModal({ listId: list.id, listName: list.nombre });
          });

          // Botón Eliminar con seguro de confirmación
          card.querySelector('.delete-btn')!.addEventListener('click', async () => {
            const accion = list.isOwner ? 'eliminar' : 'desvincularte de';
            if (!currentUid || !window.confirm(`¿Deseas ${accion} la lista «${list.nombre}»?`)) return;
            try {
              await deleteUserList(currentUid, list.id, list.isOwner);
              loadLists(currentUid, currentUserEmail);
            } catch (err: any) {
              alert(err.message || 'Error al eliminar la lista');
            }
          });

          listsGrid.append(card);
        });
      }

      function updateShoppingDropdown() {
        shoppingListSelect.replaceChildren();
        if (cachedLists.length === 0) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'No tienes listas creadas';
          shoppingListSelect.append(opt);
          return;
        }

        cachedLists.forEach((l) => {
          const opt = document.createElement('option');
          opt.value = l.id;
          const prefix = l.tipo === 'receta' ? '🍳 ' : '🛒 ';
          opt.textContent = `${prefix}${l.nombre} (${l.items.length} productos)`;
          shoppingListSelect.append(opt);
        });

        if (activeShoppingList) {
          shoppingListSelect.value = activeShoppingList.id;
        }
      }

      function selectShoppingList(listId: string) {
        const found = cachedLists.find((l) => l.id === listId);
        if (!found) return;
        activeShoppingList = found;
        shoppingListSelect.value = listId;

        renderShoppingChecklist(found);

        // Suscripción en tiempo real a los cambios de la lista
        if (unsubscribeShoppingLive) unsubscribeShoppingLive();
        unsubscribeShoppingLive = subscribeList(listId, (updated) => {
          if (!updated) return;
          const idx = cachedLists.findIndex((l) => l.id === listId);
          if (idx !== -1) cachedLists[idx] = updated;
          activeShoppingList = updated;
          renderShoppingChecklist(updated);
        });
      }

      function renderShoppingChecklist(list: SavedList) {
        shoppingItemsContainer.replaceChildren();

        const total = list.items.length;
        const bought = list.items.filter((i) => i.comprado).length;
        const pct = total > 0 ? Math.round((bought / total) * 100) : 0;

        shoppingProgressText.textContent = `${bought} de ${total} en el carrito (${pct}%)`;
        shoppingProgressFill.style.width = `${pct}%`;

        if (total === 0) {
          shoppingItemsContainer.innerHTML = `
            <div style="text-align: center; color: var(--muted); padding: 2rem;">
              <p>Esta lista no tiene productos agregados todavía.</p>
              <a href="/?tab=list&listaId=${list.id}" class="btn-primary" style="display: inline-flex;">Editar productos</a>
            </div>
          `;
          return;
        }

        list.items.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = `shopping-item-row ${item.comprado ? 'is-bought' : ''}`;
          row.setAttribute('role', 'checkbox');
          row.setAttribute('aria-checked', item.comprado ? 'true' : 'false');
          row.setAttribute('tabindex', '0');

          const isMe = currentUid && item.addedById === currentUid;
          const authorName = isMe ? 'Tú' : (item.addedBy || '');
          const authorBadge = authorName
            ? `<span class="shopping-item-author">👤 ${escapeHtml(authorName)}</span>`
            : '';

          row.innerHTML = `
            <div class="shopping-item-check"></div>
            <div class="shopping-item-info">
              <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0.35rem;">
                <h4 class="shopping-item-name" style="margin: 0;">${escapeHtml(item.nombre)}</h4>
                ${authorBadge}
              </div>
              <p class="shopping-item-meta" style="margin-top: 0.2rem;">
                <strong>${Number(item.cantidad)} ${escapeHtml(item.formato)}</strong>
                ${item.marca && item.marca.toUpperCase() !== 'TODAS' ? `· Marca: ${escapeHtml(item.marca)}` : ''}
              </p>
            </div>
          `;

          async function toggleThisItem() {
            const nextBought = !item.comprado;
            item.comprado = nextBought;
            row.classList.toggle('is-bought', nextBought);
            row.setAttribute('aria-checked', nextBought ? 'true' : 'false');

            const newBought = list.items.filter((i) => i.comprado).length;
            const newPct = total > 0 ? Math.round((newBought / total) * 100) : 0;
            shoppingProgressText.textContent = `${newBought} de ${total} en el carrito (${newPct}%)`;
            shoppingProgressFill.style.width = `${newPct}%`;

            try {
              await toggleItemBought(list.id, index, nextBought);
            } catch (err) {
              console.error('Error al actualizar item:', err);
            }
          }

          row.addEventListener('click', toggleThisItem);
          row.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'Enter') {
              e.preventDefault();
              toggleThisItem();
            }
          });

          shoppingItemsContainer.append(row);
        });
      }

      shoppingListSelect.addEventListener('change', () => {
        selectShoppingList(shoppingListSelect.value);
      });

      shoppingCompareBtn.addEventListener('click', () => {
        if (!activeShoppingList) return;
        localStorage.setItem('comparador-lista', JSON.stringify(activeShoppingList.items));
        if (activeShoppingList.ciudad) {
          localStorage.setItem('comparador-ciudad', activeShoppingList.ciudad);
        }
        window.location.href = `/?tab=list&listaId=${activeShoppingList.id}`;
      });

      // Seguro para desmarcar: Confirmación obligatoria para evitar accidentes
      shoppingResetBtn.addEventListener('click', async () => {
        if (!activeShoppingList) return;
        const confirmReset = window.confirm(
          `🔒 ¿Seguro que deseas desmarcar todos los productos de «${activeShoppingList.nombre}» para empezar una nueva compra?`
        );
        if (!confirmReset) return;

        shoppingResetBtn.disabled = true;
        shoppingResetBtn.textContent = 'Desmarcando…';
        try {
          for (let i = 0; i < activeShoppingList.items.length; i++) {
            if (activeShoppingList.items[i].comprado) {
              activeShoppingList.items[i].comprado = false;
              await toggleItemBought(activeShoppingList.id, i, false);
            }
          }
          renderShoppingChecklist(activeShoppingList);
        } finally {
          shoppingResetBtn.disabled = false;
          shoppingResetBtn.textContent = '🔒 Desmarcar todo';
        }
      });

      function renderUserQuickMeta(data: UserProfileData | null) {
        userQuickMeta.replaceChildren();
        if (!data || (!data.direccionPrincipal && !data.telefono && !data.ciudadPrincipal)) {
          const emptyBadge = document.createElement('span');
          emptyBadge.className = 'user-quick-badge';
          emptyBadge.innerHTML = '📍 <em>Sin direcciones guardadas · Puedes agregarlas en «Mis Direcciones»</em>';
          userQuickMeta.append(emptyBadge);
          return;
        }

        if (data.direccionPrincipal) {
          const badge = document.createElement('span');
          badge.className = 'user-quick-badge';
          const barrio = data.barrioPrincipal ? ` (${escapeHtml(data.barrioPrincipal)})` : '';
          badge.innerHTML = `🏠 <strong>Principal:</strong> ${escapeHtml(data.direccionPrincipal)}${barrio}`;
          userQuickMeta.append(badge);
        }

        if (data.direccionSecundaria) {
          const badge = document.createElement('span');
          badge.className = 'user-quick-badge';
          const barrio = data.barrioSecundario ? ` (${escapeHtml(data.barrioSecundario)})` : '';
          badge.innerHTML = `🏢 <strong>Secundaria:</strong> ${escapeHtml(data.direccionSecundaria)}${barrio}`;
          userQuickMeta.append(badge);
        }

        if (data.ciudadPrincipal) {
          const cName = CITIES.find((c) => c.id === data.ciudadPrincipal)?.name || data.ciudadPrincipal;
          const badge = document.createElement('span');
          badge.className = 'user-quick-badge';
          badge.innerHTML = `🏙️ <strong>Ciudad:</strong> ${escapeHtml(cName)}`;
          userQuickMeta.append(badge);
        }

        if (data.telefono) {
          const badge = document.createElement('span');
          badge.className = 'user-quick-badge';
          badge.innerHTML = `📱 <strong>Tel:</strong> ${escapeHtml(data.telefono)}`;
          userQuickMeta.append(badge);
        }
      }

      async function loadUserProfileData(uid: string, user: any) {
        try {
          const profile = await getUserProfile(uid);
          const currentCityInStorage = localStorage.getItem('comparador-ciudad') || 'bogota';

          if (profile) {
            profileInputName.value = profile.nombre || user.displayName || '';
            profileInputPhone.value = profile.telefono || '';
            profileSelectCity.value = profile.ciudadPrincipal || currentCityInStorage;
            profileInputAddressMain.value = profile.direccionPrincipal || '';
            profileInputNeighborhoodMain.value = profile.barrioPrincipal || '';
            profileInputAddressSec.value = profile.direccionSecundaria || '';
            profileInputNeighborhoodSec.value = profile.barrioSecundario || '';
            profileInputNotes.value = profile.notasUbicacion || '';
            renderUserQuickMeta(profile);
          } else {
            profileInputName.value = user.displayName || '';
            profileInputPhone.value = '';
            profileSelectCity.value = currentCityInStorage;
            profileInputAddressMain.value = '';
            profileInputNeighborhoodMain.value = '';
            profileInputAddressSec.value = '';
            profileInputNeighborhoodSec.value = '';
            profileInputNotes.value = '';
            renderUserQuickMeta(null);
          }
        } catch (e) {
          console.warn('Error al cargar datos del perfil:', e);
        }
      }

      profileDataForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentUid) return;

        profileSaveBtn.disabled = true;
        profileSaveBtn.textContent = 'Guardando…';
        profileSaveStatus.className = 'profile-save-status';
        profileSaveStatus.textContent = 'Guardando datos en la nube…';

        const updatedProfile: Partial<UserProfileData> = {
          nombre: profileInputName.value.trim(),
          telefono: profileInputPhone.value.trim(),
          ciudadPrincipal: profileSelectCity.value,
          direccionPrincipal: profileInputAddressMain.value.trim(),
          barrioPrincipal: profileInputNeighborhoodMain.value.trim(),
          direccionSecundaria: profileInputAddressSec.value.trim(),
          barrioSecundario: profileInputNeighborhoodSec.value.trim(),
          notasUbicacion: profileInputNotes.value.trim(),
          email: currentUserEmail || undefined,
        };

        try {
          await saveUserProfile(currentUid, updatedProfile);

          // Sincronizar ciudad preferida con comparador local
          if (updatedProfile.ciudadPrincipal) {
            localStorage.setItem('comparador-ciudad', updatedProfile.ciudadPrincipal);
          }

          if (updatedProfile.nombre) {
            userDisplayName.textContent = updatedProfile.nombre;
          }

          renderUserQuickMeta({ ...updatedProfile, uid: currentUid });

          profileSaveStatus.className = 'profile-save-status is-success';
          profileSaveStatus.textContent = '¡Tus datos de ubicación y contacto se guardaron con éxito! ✅';

          setTimeout(() => {
            if (profileSaveStatus.textContent.includes('éxito')) {
              profileSaveStatus.textContent = '';
            }
          }, 4500);
        } catch (err: any) {
          console.error('Error al guardar datos:', err);
          profileSaveStatus.className = 'profile-save-status is-error';
          profileSaveStatus.textContent = 'Ocurrió un error al guardar los datos. Intenta nuevamente.';
        } finally {
          profileSaveBtn.disabled = false;
          profileSaveBtn.textContent = '💾 Guardar datos';
        }
      });

      async function loadLists(uid: string, email?: string | null) {
        listsStatus.textContent = 'Cargando tus listas…';
        try {
          const lists = await getUserLists(uid, email);
          cachedLists = lists;
          listsStatus.textContent = '';
          renderLists(lists);
          updateShoppingDropdown();

          // Revisar si viene con parámetro de modo compra o pestañas
          const urlParams = new URLSearchParams(window.location.search);
          const paramListId = urlParams.get('listaId');
          const isShoppingMode = urlParams.get('modo') === 'compra' || !!paramListId;
          const paramTab = urlParams.get('tab');

          if (paramTab === 'datos' || paramTab === 'direcciones') {
            setProfileTab('data');
          } else if (isShoppingMode && lists.length > 0) {
            const targetId = paramListId && lists.some((l) => l.id === paramListId) ? paramListId : lists[0].id;
            selectShoppingList(targetId);
            setProfileTab('shopping');
          }
        } catch (err: any) {
          listsStatus.textContent = 'No se pudieron cargar las listas.';
        }
      }

      profileLoginBtn.addEventListener('click', async () => {
        try {
          await loginWithGoogle();
        } catch (err: any) {
          console.error('Error al iniciar sesión con Google:', err);
          let msg = err.message || 'Error al iniciar sesión';
          if (err.code === 'auth/unauthorized-domain') {
            msg = `El dominio «${window.location.hostname}» no está autorizado en Firebase. Agrégalo en Firebase Console > Authentication > Settings > Authorized domains.`;
          } else if (err.code === 'auth/popup-blocked') {
            msg = 'Tu navegador bloqueó la ventana emergente de Google. Por favor habilita los popups para este sitio.';
          } else if (err.code === 'auth/popup-closed-by-user') {
            msg = 'Se cerró la ventana emergente antes de completar el inicio de sesión.';
          }
          alert(msg);
        }
      });

      profileLogoutBtn.addEventListener('click', async () => {
        if (unsubscribeShoppingLive) unsubscribeShoppingLive();
        if (unsubscribeUserListsLive) unsubscribeUserListsLive();
        await logoutUser();
        window.location.href = '/';
      });

      subscribeAuth((user) => {
        if (user) {
          currentUid = user.uid;
          currentUserEmail = user.email || null;
          authGate.hidden = true;
          userProfile.hidden = false;
          profileTabsNav.hidden = false;
          listsSection.hidden = false;

          userDisplayName.textContent = user.displayName || 'Usuario';
          userEmail.textContent = user.email || '';

          if (unsubscribeUserListsLive) unsubscribeUserListsLive();
          unsubscribeUserListsLive = subscribeUserLists(user.uid, currentUserEmail, (liveLists) => {
            cachedLists = liveLists;
            listsStatus.textContent = '';
            renderLists(liveLists);
            updateShoppingDropdown();
          });

          loadLists(user.uid, currentUserEmail);
          loadUserProfileData(user.uid, user);
        } else {
          currentUid = null;
          currentUserEmail = null;
          if (unsubscribeShoppingLive) unsubscribeShoppingLive();
          if (unsubscribeUserListsLive) unsubscribeUserListsLive();
          authGate.hidden = false;
          userProfile.hidden = true;
          profileTabsNav.hidden = true;
          listsSection.hidden = true;
          shoppingSection.hidden = true;
          dataSection.hidden = true;
        }
      });
    </script>
  </body>
</html>
